{
  "plan": "deletelink_link1",
  "question": "Delete a link of type 1 by marking it hidden, leaving the link in place.",
  "for": "all formats",
  "params": {
    "src": {
      "type": "id"
    },
    "dst": {
      "type": "id"
    }
  },
  "let": {
    "s_vid": {
      "if": [
        {
          "is_digit": {
            "param": "src"
          }
        },
        {
          "vid": [
            {
              "lit": "Node"
            },
            {
              "param": "src"
            }
          ]
        },
        {
          "param": "src"
        }
      ]
    },
    "d_vid": {
      "if": [
        {
          "is_digit": {
            "param": "dst"
          }
        },
        {
          "vid": [
            {
              "lit": "Node"
            },
            {
              "param": "dst"
            }
          ]
        },
        {
          "param": "dst"
        }
      ]
    }
  },
  "steps": [
    {
      "name": "out",
      "op": "update_edge_prop",
      "etype": "link1",
      "src": {
        "let": "s_vid"
      },
      "dst": {
        "let": "d_vid"
      },
      "props": {
        "visibility": 0
      },
      "src_label": "Node",
      "dst_label": "Node"
    }
  ],
  "output": "out"
}
