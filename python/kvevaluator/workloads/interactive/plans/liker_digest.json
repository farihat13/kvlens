          "right_on": "_vid"
        },
        {
          "name": "out",
          "op": "project",
          "rows": {
            "ref": "with_msg"
          },
          "fields": [
            "id",
            "firstName",
            "lastName",
            "gender",
            "birthday",
            "creationDate",
            "locationIP",
            "browserUsed",
            "likeCreationDate",
            "messageId",
            "messageContent",
            "messageImageFile",
            "messageCreationDate",
            "messageLocationIP",
