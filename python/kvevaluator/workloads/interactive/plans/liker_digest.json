        },
        {
          "name": "liker_props",
          "op": "read_vertex_props",
          "vids": {
            "ref": "liker_v"
          },
          "props": [
            "id",
            "firstName",
            "lastName",
            "gender",
            "birthday",
            "creationDate",
            "locationIP",
            "browserUsed"
          ],
          "label": "Person"
        },
        {
          "name": "liker_join",
          "op": "join",
          "left": {
            "ref": "cand"
          },
          "right": {
            "ref": "liker_props"
          },
          "left_on": "_vid",
          "right_on": "_vid"
        },
        {
          "name": "top20",
          "op": "top_k",
          "rows": {
            "ref": "liker_join"
          },
          "keys": [
            [
              "likeCreationDate",
              "desc"
            ],
            [
              "id",
              "asc"
            ]
          ],
          "k": 20
        },
        {
          "name": "msg_v",
          "op": "pluck",
          "rows": {
            "ref": "top20"
          },
          "field": "_msg"
        },
        {
          "name": "msg_props",
          "op": "read_vertex_props",
          "vids": {
