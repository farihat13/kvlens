{
  "plan": "liker_digest",
  "question": "Given a person, find the 20 most recent likes of their messages, with the full profile of each liker and the full liked message.",
  "params_like": "ic1",
  "generated_by": "python/kvevaluator/plan_choice/generate.py",
  "params": {
