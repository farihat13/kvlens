+
+#ifdef ARANGO_KV_HISTOGRAMS
+// Engine-wrapper latency-histogram emission. Emits {count, sum, min, max,
+// p50/p75/p99/p999, bucket_width, num_buckets, overflow_count, buckets} matching
+// Nebula's ResettableHistogram::toJson() bucket shape (see KvLatencyHistogram for
+// the get found/notfound caveat). One KvLatencyHistogram per op kind
+// (get/seek/next/prev; next = forward iteration, prev = reverse).
+void KvLatencyHistogram::toVPack(VPackBuilder& builder) const noexcept {
+  // Walk cumulative bucket counts to find the bucket containing the target rank,
+  // return its upper bound. Lambda over our members.
+  auto pct = [this](double p) -> uint64_t {
+    uint64_t total = count.load(std::memory_order_relaxed);
+    if (total == 0) return 0;
+    uint64_t threshold = static_cast<uint64_t>(total * p);
+    if (threshold == 0) threshold = 1;
+    uint64_t cumulative = 0;
+    for (uint32_t i = 0; i <= kNumBuckets; ++i) {
+      cumulative += buckets[i].load(std::memory_order_relaxed);
+      if (cumulative >= threshold) {
+        return static_cast<uint64_t>(i + 1) * kBucketWidth;
+      }
+    }
+    return static_cast<uint64_t>(kNumBuckets) * kBucketWidth;
+  };
+
+  uint64_t n = count.load(std::memory_order_relaxed);
+  uint64_t minVal = min.load(std::memory_order_relaxed);
+  uint64_t maxVal = max.load(std::memory_order_relaxed);
+  uint64_t overflow = buckets[kNumBuckets].load(std::memory_order_relaxed);
+
+  builder.add("count", VPackValue(n));
+  builder.add("sum", VPackValue(sum.load(std::memory_order_relaxed)));
+  builder.add("min", VPackValue(n > 0 ? minVal : 0));
+  builder.add("max", VPackValue(maxVal));
+  builder.add("p50", VPackValue(pct(0.50)));
+  builder.add("p75", VPackValue(pct(0.75)));
+  builder.add("p99", VPackValue(pct(0.99)));
+  builder.add("p999", VPackValue(pct(0.999)));
+  builder.add("bucket_width", VPackValue(kBucketWidth));
+  builder.add("num_buckets", VPackValue(kNumBuckets));
+  builder.add("overflow_count", VPackValue(overflow));
+  builder.add("buckets", VPackValue(VPackValueType::Array));
+  for (uint32_t i = 0; i <= kNumBuckets; ++i) {
+    uint64_t c = buckets[i].load(std::memory_order_relaxed);
+    if (c == 0) {
+      continue;
+    }
+    builder.add(VPackValue(VPackValueType::Object));
+    builder.add("lo", VPackValue(static_cast<uint64_t>(i) * kBucketWidth));
+    if (i == kNumBuckets) {
+      builder.add("hi", VPackValue(VPackValueType::Null));
+    } else {
+      builder.add("hi", VPackValue(static_cast<uint64_t>(i + 1) * kBucketWidth));
+    }
+    builder.add("count", VPackValue(c));
+    builder.close();
+  }
+  builder.close();  // buckets array
+}
+
+void RocksDBEngine::kvLatencyHistogramsToVPack(VPackBuilder& builder) const noexcept {
+  builder.add("get_latency", VPackValue(VPackValueType::Object));
+  _kvGetHist.toVPack(builder);
+  builder.close();
+  builder.add("seek_latency", VPackValue(VPackValueType::Object));
+  _kvSeekHist.toVPack(builder);
+  builder.close();
+  builder.add("next_latency", VPackValue(VPackValueType::Object));
+  _kvNextHist.toVPack(builder);
+  builder.close();
+  builder.add("prev_latency", VPackValue(VPackValueType::Object));
+  _kvPrevHist.toVPack(builder);
+  builder.close();
+}
+
+void RocksDBEngine::resetKvLatencyHistograms() noexcept {
+  _kvGetHist.reset();
+  _kvSeekHist.reset();
+  _kvNextHist.reset();
+  _kvPrevHist.reset();
+}
+#endif  // ARANGO_KV_HISTOGRAMS
