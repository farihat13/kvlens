+////////////////////////////////////////////////////////////////////////////////
+/// Unified REST handler for /_admin/kvstats — per-query RocksDB KV statistics.
+///
+/// Emits whichever sections are compiled in (ARANGO_KV_TICKERS / ARANGO_KV_HISTOGRAMS
+/// / ARANGO_KV_STATS). See arangodb.unified.patch.
+////////////////////////////////////////////////////////////////////////////////
+
+#include "RocksDBRestKVStatsHandler.h"
+
+#include "ApplicationFeatures/ApplicationServer.h"
+#include "RocksDBEngine/RocksDBEngine.h"
+#include "StorageEngine/EngineSelectorFeature.h"
+
+#ifdef ARANGO_KV_TICKERS
+// Native tickers + native histograms both read RocksDB's statistics object.
+#include <rocksdb/statistics.h>
+#endif
+
+using namespace arangodb;
+using namespace arangodb::rest;
+
+RocksDBRestKVStatsHandler::RocksDBRestKVStatsHandler(
+    application_features::ApplicationServer& server, GeneralRequest* request,
+    GeneralResponse* response)
+    : RestBaseHandler(server, request, response) {}
+
+RestStatus RocksDBRestKVStatsHandler::execute() {
+  auto const type = _request->requestType();
+  auto const& suffixes = _request->suffixes();
+
+  if (type == rest::RequestType::GET && suffixes.empty()) {
+    readStats();
+  } else if (type == rest::RequestType::PUT && suffixes.size() == 1 &&
+             suffixes[0] == "reset") {
+    resetStats();
+  } else {
+    generateError(rest::ResponseCode::METHOD_NOT_ALLOWED,
+                  TRI_ERROR_HTTP_METHOD_NOT_ALLOWED,
+                  "use GET /_admin/kvstats or PUT /_admin/kvstats/reset");
+  }
+  return RestStatus::DONE;
+}
+
+void RocksDBRestKVStatsHandler::readStats() {
+  auto& engine =
+      server().getFeature<EngineSelectorFeature>().engine<RocksDBEngine>();
+  (void)engine;  // may be unused if no instrumentation flag is set
+
+  VPackBuilder builder;
+  builder.openObject();
+
+#ifdef ARANGO_KV_TICKERS
+  // RocksDB native statistics — the process-global op-count tickers and the
+  // native latency histograms. Both come from RocksDB's own statistics object,
+  // so both need --rocksdb.enable-statistics true and live under one flag. This
+  // is the layer ArangoDB has but NebulaGraph does not; the engine-wrapper counts
+  // (ARANGO_KV_STATS) are the apples-to-apples cross-DB signal.
+  {
+    auto const& opts = engine.rocksDBOptions();
+    if (opts.statistics) {
+      // Ticker counts — all standard RocksDB tickers (op counts).
+      builder.add("tickers", VPackValue(VPackValueType::Object));
+      for (auto const& t : rocksdb::TickersNameMap) {
+        builder.add(t.second,
+                    VPackValue(opts.statistics->getTickerCount(t.first)));
+      }
+      builder.close();  // tickers
+      // Native RocksDB latency histograms (db.get.micros, etc.).
+      builder.add("native_histograms", VPackValue(VPackValueType::Object));
+      for (auto const& h : rocksdb::HistogramsNameMap) {
+        rocksdb::HistogramData data;
+        opts.statistics->histogramData(h.first, &data);
+        if (data.count > 0) {
+          builder.add(h.second, VPackValue(VPackValueType::Object));
+          builder.add("count", VPackValue(data.count));
+          builder.add("sum", VPackValue(data.sum));
+          builder.add("avg", VPackValue(data.average));
+          builder.add("median", VPackValue(data.median));
+          builder.add("p95", VPackValue(data.percentile95));
+          builder.add("p99", VPackValue(data.percentile99));
+          builder.add("min", VPackValue(data.min));
+          builder.add("max", VPackValue(data.max));
+          // Raw RocksDB bucket-distribution text dump. Each non-empty bucket line
+          // is "[ lo, hi ) count pct% cum% ##bars" — parsed Python-side. RocksDB's
+          // public Statistics API doesn't expose raw bucket counts any other way.
+          builder.add("buckets_raw",
+                      VPackValue(opts.statistics->getHistogramString(h.first)));
+          builder.close();  // histogram entry
+        }
+      }
+      builder.close();  // native_histograms
+    } else {
+      // Compiled with ARANGO_KV_TICKERS but the server was started without
+      // --rocksdb.enable-statistics true: report it rather than failing, so the
+      // engine-wrapper sections below are still returned.
+      builder.add("statistics_enabled", VPackValue(false));
+    }
+  }
+#endif  // ARANGO_KV_TICKERS
+
+#ifdef ARANGO_KV_STATS
+  // Engine-wrapper hand counters: flat get_/seek_/next_/prev_ count + found +
+  // time_ns + bytes from the RocksDBMethods / TimedRocksDBIterator path (next =
+  // forward iteration, prev = reverse, split like NebulaGraph's iterator_next/prev).
+  // No runtime flag needed. The ArangoDB analog of NebulaGraph's KV_STATS counters.
+  engine.getKvStats(builder);
+#endif
+
+#ifdef ARANGO_KV_HISTOGRAMS
+  // Engine-wrapper latency histograms: get_latency / seek_latency / next_latency /
+  // prev_latency, hand-maintained from the same timing as ARANGO_KV_STATS (no
+  // RocksDB statistics needed). Same {lo,hi,count} bucket schema as NebulaGraph's
+  // KV_HISTOGRAMS (see KvLatencyHistogram for the GET found/notfound caveat).
+  // Requires ARANGO_KV_STATS.
+  builder.add("histograms", VPackValue(VPackValueType::Object));
+  engine.kvLatencyHistogramsToVPack(builder);
+  builder.close();  // histograms
+#endif
+
+  builder.close();  // root object
+  generateResult(rest::ResponseCode::OK, builder.slice());
+}
+
+void RocksDBRestKVStatsHandler::resetStats() {
+  auto& engine =
+      server().getFeature<EngineSelectorFeature>().engine<RocksDBEngine>();
+  (void)engine;
+
+#ifdef ARANGO_KV_TICKERS
+  {
+    auto const& opts = engine.rocksDBOptions();
+    if (opts.statistics) {
+      opts.statistics->Reset();
+    }
+  }
+#endif
+#ifdef ARANGO_KV_STATS
+  engine.resetKvStats();
+#endif
+#ifdef ARANGO_KV_HISTOGRAMS
+  engine.resetKvLatencyHistograms();
+#endif
+
+  VPackBuilder result;
+  result.openObject();
+  result.add("reset", VPackValue(true));
+  result.close();
+  generateResult(rest::ResponseCode::OK, result.slice());
+}
diff --git a/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/RocksDBRestKVStatsHandler.h b/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/RocksDBRestKVStatsHandler.h
new file mode 100644
index 000000000..bc9216f9f
--- /dev/null
+++ b/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/RocksDBRestKVStatsHandler.h
@@ -0,0 +1,42 @@
+////////////////////////////////////////////////////////////////////////////////
+/// Unified REST handler for per-query RocksDB KV statistics.
+///
+///   GET  /_admin/kvstats        — read whatever instrumentation is compiled in
+///   PUT  /_admin/kvstats/reset  — reset all counters to zero
+///
+/// The response is a superset shaped by the compile-time flags (see
+/// arangodb.unified.patch). Flag names are aligned with NebulaGraph's by layer:
+///   ARANGO_KV_TICKERS    → "tickers" + "native_histograms" (RocksDB native,
+///                          process-global; no NebulaGraph analog)
+///   ARANGO_KV_STATS      → flat get_/seek_/next_/prev_ count + found + time_ns +
+///                          bytes (engine-wrapper hand counters, next=forward /
+///                          prev=reverse; = NebulaGraph KV_STATS)
+///   ARANGO_KV_HISTOGRAMS → "histograms" (engine-wrapper get/seek/next/prev latency
+///                          histograms; NebulaGraph-aligned bucket shape, but a
+///                          single get_latency vs Nebula's found/notfound split;
+///                          needs KV_STATS)
+///
+/// ARANGO_KV_TICKERS needs --rocksdb.enable-statistics true; the engine-wrapper
+/// sections (KV_STATS / KV_HISTOGRAMS) need no runtime flag.
+////////////////////////////////////////////////////////////////////////////////
+
+#pragma once
+
+#include "RestHandler/RestBaseHandler.h"
+
+namespace arangodb {
+
+class RocksDBRestKVStatsHandler : public arangodb::RestBaseHandler {
+ public:
+  RocksDBRestKVStatsHandler(application_features::ApplicationServer&,
+                            GeneralRequest*, GeneralResponse*);
+
+  RestStatus execute() override;
+  char const* name() const override { return "RocksDBRestKVStatsHandler"; }
+  RequestLane lane() const override final { return RequestLane::CLIENT_SLOW; }
+
+ private:
+  void readStats();
+  void resetStats();
+};
+}  // namespace arangodb
diff --git a/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/RocksDBRestKVTraceHandler.cpp b/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/RocksDBRestKVTraceHandler.cpp
new file mode 100644
index 000000000..8aebf28aa
--- /dev/null
+++ b/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/RocksDBRestKVTraceHandler.cpp
@@ -0,0 +1,103 @@
+////////////////////////////////////////////////////////////////////////////////
+/// REST handler for per-key RocksDB KV tracing (arangodb.unified.patch).
+/// See RocksDBRestKVTraceHandler.h for the endpoint contract.
+////////////////////////////////////////////////////////////////////////////////
+
+#include "RocksDBRestKVTraceHandler.h"
+
+#include "ApplicationFeatures/ApplicationServer.h"
+#include "RocksDBEngine/RocksDBEngine.h"
+#include "StorageEngine/EngineSelectorFeature.h"
+
+using namespace arangodb;
+using namespace arangodb::rest;
+
+RocksDBRestKVTraceHandler::RocksDBRestKVTraceHandler(
+    application_features::ApplicationServer& server, GeneralRequest* request,
+    GeneralResponse* response)
+    : RestBaseHandler(server, request, response) {}
+
+RestStatus RocksDBRestKVTraceHandler::execute() {
+  auto const type = _request->requestType();
+  auto const& suffixes = _request->suffixes();
+
+  if (type == rest::RequestType::GET && suffixes.empty()) {
+    readTrace();
+  } else if (type == rest::RequestType::PUT && suffixes.size() == 1 &&
+             suffixes[0] == "enable") {
+    enableTrace();
+  } else if (type == rest::RequestType::PUT && suffixes.size() == 1 &&
+             suffixes[0] == "disable") {
+    disableTrace();
+  } else if (type == rest::RequestType::PUT && suffixes.size() == 1 &&
+             suffixes[0] == "clear") {
+    clearTrace();
+  } else {
+    generateError(rest::ResponseCode::METHOD_NOT_ALLOWED,
+                  TRI_ERROR_HTTP_METHOD_NOT_ALLOWED,
+                  "use GET /_admin/kvtrace, or PUT /_admin/kvtrace/"
+                  "{enable[?max=N],disable,clear}");
+  }
+  return RestStatus::DONE;
+}
+
+#ifdef ARANGO_KV_STATS
+void RocksDBRestKVTraceHandler::readTrace() {
+  auto& engine =
+      server().getFeature<EngineSelectorFeature>().engine<RocksDBEngine>();
+  VPackBuilder builder;
+  builder.openObject();
+  engine.kvTraceToVPack(builder);
+  builder.close();
+  generateResult(rest::ResponseCode::OK, builder.slice());
+}
+
+void RocksDBRestKVTraceHandler::enableTrace() {
+  auto& engine =
+      server().getFeature<EngineSelectorFeature>().engine<RocksDBEngine>();
+  // ?max=N caps the buffer; default mirrors NebulaGraph's 100000.
+  uint64_t maxEntries = _request->parsedValue<uint64_t>("max", 100000);
+  engine.kvTraceEnable(static_cast<size_t>(maxEntries));
+
+  VPackBuilder result;
+  result.openObject();
+  result.add("enabled", VPackValue(true));
+  result.add("max", VPackValue(maxEntries));
+  result.close();
+  generateResult(rest::ResponseCode::OK, result.slice());
+}
+
+void RocksDBRestKVTraceHandler::disableTrace() {
+  auto& engine =
+      server().getFeature<EngineSelectorFeature>().engine<RocksDBEngine>();
+  engine.kvTraceDisable();
+
+  VPackBuilder result;
+  result.openObject();
+  result.add("enabled", VPackValue(false));
+  result.close();
+  generateResult(rest::ResponseCode::OK, result.slice());
+}
+
+void RocksDBRestKVTraceHandler::clearTrace() {
+  auto& engine =
+      server().getFeature<EngineSelectorFeature>().engine<RocksDBEngine>();
+  engine.kvTraceClear();
+
+  VPackBuilder result;
+  result.openObject();
+  result.add("cleared", VPackValue(true));
+  result.close();
+  generateResult(rest::ResponseCode::OK, result.slice());
+}
+#else
+// Built without -DARANGO_KV_STATS: the trace buffer does not exist. Report it
+// rather than failing to link, so the endpoint degrades gracefully.
+void RocksDBRestKVTraceHandler::readTrace() {
+  generateError(rest::ResponseCode::NOT_IMPLEMENTED, TRI_ERROR_NOT_IMPLEMENTED,
+                "KV tracing not compiled in (needs -DARANGO_KV_STATS=ON)");
+}
+void RocksDBRestKVTraceHandler::enableTrace() { readTrace(); }
+void RocksDBRestKVTraceHandler::disableTrace() { readTrace(); }
+void RocksDBRestKVTraceHandler::clearTrace() { readTrace(); }
+#endif
