new file mode 100644
index 000000000..edde95cf0
--- /dev/null
+++ b/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/RocksDBRestKVTraceHandler.h
@@ -0,0 +1,41 @@
+////////////////////////////////////////////////////////////////////////////////
+/// REST handler for per-key RocksDB KV tracing — the ArangoDB analog of
+/// NebulaGraph's storaged /kvtrace.
+///
+///   PUT  /_admin/kvtrace/enable[?max=N] — start tracing (clears the buffer;
+///                                         default cap 100000 entries)
+///   PUT  /_admin/kvtrace/disable        — stop tracing
+///   PUT  /_admin/kvtrace/clear          — empty the buffer, keep tracing state
+///   GET  /_admin/kvtrace                — read the captured entries
+///
+/// Each entry is {op, key (hex), cf, key_size, value_size}. Only engine-wrapper
+/// GETs and iterator SEEKs are traced (op = "get" | "seek"); NEXT/PREV stay
+/// counter-only so a row-walk can't explode the buffer (see arangodb.unified.patch).
+///
+/// The whole feature lives behind -DARANGO_KV_STATS=ON (the trace buffer hangs off
+/// the same RocksDBEngine instrumentation). When that flag is off, the endpoints
+/// report that tracing was not compiled in rather than failing to link.
+////////////////////////////////////////////////////////////////////////////////
+
+#pragma once
+
+#include "RestHandler/RestBaseHandler.h"
+
+namespace arangodb {
+
+class RocksDBRestKVTraceHandler : public arangodb::RestBaseHandler {
+ public:
+  RocksDBRestKVTraceHandler(application_features::ApplicationServer&,
+                            GeneralRequest*, GeneralResponse*);
+
+  RestStatus execute() override;
+  char const* name() const override { return "RocksDBRestKVTraceHandler"; }
+  RequestLane lane() const override final { return RequestLane::CLIENT_SLOW; }
+
+ private:
+  void readTrace();
+  void enableTrace();
+  void disableTrace();
+  void clearTrace();
+};
+}  // namespace arangodb
diff --git a/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/TimedRocksDBIterator.h b/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/TimedRocksDBIterator.h
new file mode 100644
index 000000000..c586aaa07
--- /dev/null
+++ b/arangodb/arangodb-3.12.8/arangod/RocksDBEngine/TimedRocksDBIterator.h
@@ -0,0 +1,123 @@
+////////////////////////////////////////////////////////////////////////////////
+/// @brief Iterator decorator that times Seek and Next/Prev operations.
+///
+/// Wraps a rocksdb::Iterator and increments the global RocksDBEngine seek/next
+/// time, count, and byte counters. Created by instrumented NewIterator()
+/// implementations. Bytes = key+value size at the position the op landed on.
+///
+/// Compiled only when -DARANGO_KV_STATS=ON (see arangodb.unified.patch). When
+/// the flag is off this header is empty, so it is safe to include unconditionally.
+////////////////////////////////////////////////////////////////////////////////
+
+#pragma once
+
+#ifdef ARANGO_KV_STATS
+
+#include "RocksDBEngine/RocksDBEngine.h"
+
+#include <chrono>
+#include <memory>
+#include <rocksdb/iterator.h>
+
+namespace arangodb {
+
+class TimedRocksDBIterator final : public rocksdb::Iterator {
+ public:
+  TimedRocksDBIterator(std::unique_ptr<rocksdb::Iterator> inner,
+                       RocksDBEngine& engine, rocksdb::ColumnFamilyHandle* cf)
+      : _inner(std::move(inner)), _engine(engine), _cf(cf) {}
+
+  // --- Seek operations (timed → seek counter) ---
+
+  void Seek(rocksdb::Slice const& target) override {
+    auto start = std::chrono::steady_clock::now();
+    _inner->Seek(target);
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    _engine.addRocksdbSeekTime(ns, landedBytes());
+    // Trace the probed key (the seek origin), mirroring NebulaGraph's
+    // appendTrace("prefix"/"range", start). The target carries the objectId that
+    // identifies the collection/index probed even if the seek lands nowhere.
+    _engine.appendKvTrace("seek", target, _cf);
+  }
+
+  void SeekToFirst() override {
+    auto start = std::chrono::steady_clock::now();
+    _inner->SeekToFirst();
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    _engine.addRocksdbSeekTime(ns, landedBytes());
+    // No target key for a full-CF seek; record where the cursor landed (or an
+    // empty key if the family is empty) so #seek entries == seek_count exactly.
+    _engine.appendKvTrace("seek", _inner->Valid() ? _inner->key() : rocksdb::Slice(),
+                          _cf);
+  }
+
+  void SeekToLast() override {
+    auto start = std::chrono::steady_clock::now();
+    _inner->SeekToLast();
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    _engine.addRocksdbSeekTime(ns, landedBytes());
+    // No target key for a full-CF seek; record where the cursor landed (or an
+    // empty key if the family is empty) so #seek entries == seek_count exactly.
+    _engine.appendKvTrace("seek", _inner->Valid() ? _inner->key() : rocksdb::Slice(),
+                          _cf);
+  }
+
+  void SeekForPrev(rocksdb::Slice const& target) override {
+    auto start = std::chrono::steady_clock::now();
+    _inner->SeekForPrev(target);
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    _engine.addRocksdbSeekTime(ns, landedBytes());
+    _engine.appendKvTrace("seek", target, _cf);
+  }
+
+  // --- Next/Prev operations (forward → next counter, reverse → prev counter) ---
+
+  void Next() override {
+    auto start = std::chrono::steady_clock::now();
+    _inner->Next();
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    _engine.addRocksdbNextTime(ns, landedBytes());
+  }
+
+  void Prev() override {
+    auto start = std::chrono::steady_clock::now();
+    _inner->Prev();
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    _engine.addRocksdbPrevTime(ns, landedBytes());
+  }
+
+  // --- Pass-through (no timing) ---
+
+  bool Valid() const override { return _inner->Valid(); }
+  rocksdb::Slice key() const override { return _inner->key(); }
+  rocksdb::Slice value() const override { return _inner->value(); }
+  rocksdb::Status status() const override { return _inner->status(); }
+  rocksdb::Slice timestamp() const override { return _inner->timestamp(); }
+  rocksdb::Status Refresh() override { return _inner->Refresh(); }
+  rocksdb::Status Refresh(rocksdb::Snapshot const* snap) override {
+    return _inner->Refresh(snap);
+  }
+
+ private:
+  // Bytes at the iterator's current position (0 if it ran off the end). Reading
+  // key()/value() on an invalid iterator is undefined, so guard with Valid().
+  uint64_t landedBytes() const {
+    return _inner->Valid() ? (_inner->key().size() + _inner->value().size()) : 0;
+  }
+
+  std::unique_ptr<rocksdb::Iterator> _inner;
+  RocksDBEngine& _engine;
+  // Column family this iterator scans; recorded with each seek trace entry so the
+  // Python decoder can label the key (Documents / PrimaryIndex / EdgeIndex / ...).
+  rocksdb::ColumnFamilyHandle* _cf;
+};
+
+}  // namespace arangodb
+
+#endif  // ARANGO_KV_STATS
