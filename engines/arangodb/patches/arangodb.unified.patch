+// ── KV key trace (arangodb.unified.patch) ──────────────────────────────────
+// The ArangoDB analog of NebulaGraph's storaged /kvtrace. Records one entry per
+// engine-wrapper GET and per iterator SEEK landing key; NEXT/PREV are not traced
+// (counter-only) to keep the buffer bounded, exactly like Nebula traces seek
+// origins rather than every row walked.
+
+namespace {
+// Lowercase-hex encode raw key bytes (matches NebulaGraph's KVStatsCounters::toHex
+// so the Python decoders treat both engines' traces identically).
+std::string kvTraceToHex(rocksdb::Slice const& key) {
+  static char const hex[] = "0123456789abcdef";
+  std::string out;
+  out.reserve(key.size() * 2);
+  for (size_t i = 0; i < key.size(); ++i) {
+    unsigned char c = static_cast<unsigned char>(key.data()[i]);
+    out.push_back(hex[c >> 4]);
+    out.push_back(hex[c & 0x0f]);
+  }
+  return out;
+}
+}  // namespace
+
+void RocksDBEngine::appendKvTrace(char const* op, rocksdb::Slice const& key,
+                                  rocksdb::ColumnFamilyHandle* cf,
+                                  uint32_t valueSize) noexcept {
+  // Fast path: one relaxed load when tracing is off (the common case).
+  if (!_kvTraceEnabled.load(std::memory_order_relaxed)) {
+    return;
+  }
+  // Resolve the column family to its short external name (documents / primary /
+  // edge / vpack / ...). cf may be null for an unscoped handle; label it "unknown".
+  char const* cfName = cf ? RocksDBColumnFamilyManager::name(cf) : "unknown";
+  // This runs on the read path and is noexcept, but push_back / string alloc can
+  // throw std::bad_alloc. Swallow it: dropping a trace entry under memory
+  // pressure is acceptable, terminating arangod is not.
+  try {
+    // Every ArangoDB key begins with the 8-byte objectId; empty keys (an empty-CF
+    // SeekToFirst/Last) have none, so record 0. Resolved to a name at fetch time.
+    uint64_t oid = key.size() >= sizeof(uint64_t) ? RocksDBKey::objectId(key) : 0;
+    std::lock_guard<std::mutex> guard(_kvTraceMutex);
+    if (_kvTrace.size() < _kvTraceMax) {
+      _kvTrace.push_back(KVTraceEntry{op, kvTraceToHex(key), cfName, oid,
+                                      static_cast<uint32_t>(key.size()), valueSize});
+    }
+  } catch (...) {
+  }
+}
+
+// kvTraceEnable / kvTraceClear / kvTraceToVPack take a lock and (for toVPack)
+// build a multi-MB VPack — both can throw (std::system_error, std::bad_alloc).
+// They are called only from the REST handler, never the read path, so they are
+// NOT noexcept: a throw propagates up and the REST framework turns it into a
+// 500, rather than std::terminate. (kvTraceDisable is a lone atomic store, so it
+// stays noexcept.)
+void RocksDBEngine::kvTraceEnable(size_t maxEntries) {
+  std::lock_guard<std::mutex> guard(_kvTraceMutex);
+  _kvTrace.clear();
+  _kvTraceMax = maxEntries;
+  _kvTraceEnabled.store(true, std::memory_order_relaxed);
+}
+
+void RocksDBEngine::kvTraceDisable() noexcept {
+  _kvTraceEnabled.store(false, std::memory_order_relaxed);
+}
+
+void RocksDBEngine::kvTraceClear() {
+  std::lock_guard<std::mutex> guard(_kvTraceMutex);
+  _kvTrace.clear();
+}
+
+void RocksDBEngine::kvTraceToVPack(VPackBuilder& builder) const {
+  // Snapshot the buffer under the trace lock, then resolve names + serialize
+  // WITHOUT it: kvTraceNameFor takes DatabaseFeature/vocbase locks, and we must
+  // never hold _kvTraceMutex while acquiring those (lock-order safety).
+  std::vector<KVTraceEntry> snapshot;
+  bool enabled;
+  size_t cap;
+  {
+    std::lock_guard<std::mutex> guard(_kvTraceMutex);
+    enabled = _kvTraceEnabled.load(std::memory_order_relaxed);
+    cap = _kvTraceMax;
+    snapshot = _kvTrace;  // copy (fetch path, not the read path)
+  }
+
+  builder.add("enabled", VPackValue(enabled));
+  builder.add("count", VPackValue(static_cast<uint64_t>(snapshot.size())));
+  builder.add("max", VPackValue(static_cast<uint64_t>(cap)));
+  builder.add("entries", VPackValue(VPackValueType::Array));
+  // A trace hits the same few collections/indexes thousands of times; resolve
+  // each objectId → name once.
+  std::unordered_map<uint64_t, std::string> nameCache;
+  for (auto const& e : snapshot) {
+    std::string name;
+    if (e.object_id != 0) {
+      auto it = nameCache.find(e.object_id);
+      if (it != nameCache.end()) {
+        name = it->second;
+      } else {
+        // documents keys map to a collection; every other CF is an index.
+        name = kvTraceNameFor(e.object_id, e.cf != "documents");
+        nameCache.emplace(e.object_id, name);
+      }
+    }
+    builder.add(VPackValue(VPackValueType::Object));
+    builder.add("op", VPackValue(e.op));
+    builder.add("key", VPackValue(e.key_hex));
+    builder.add("cf", VPackValue(e.cf));
+    builder.add("object_id", VPackValue(e.object_id));
+    builder.add("name", VPackValue(name));
+    builder.add("key_size", VPackValue(e.key_size));
+    builder.add("value_size", VPackValue(e.value_size));
+    builder.close();
+  }
+  builder.close();  // entries
+}
+
+// Resolve a traced objectId to a human name, at fetch time only. The engine's
+// objectId→collection/index maps give a logical (dbId, collectionId[, indexId]);
+// a DatabaseFeature lookup turns that into "Person" (documents) or
+// "Person.creationDate" (index). Mirrors the objectId→name resolution the WAL
+// tailer does. Empty string if the collection/index has since been dropped.
+std::string RocksDBEngine::kvTraceNameFor(uint64_t objectId, bool isIndex) const {
+  // Best-effort: a dropped collection/index or any lookup error yields an empty
+  // name, never a failed fetch (mirrors the WAL tailer's try/catch around useDatabase).
+  try {
+    auto& df = getDatabaseFeature();
+    if (isIndex) {
+      auto [dbid, cid, iid] = mapObjectToIndex(objectId);
+      if (dbid == 0 || cid.empty()) return {};
+      auto vocbase = df.useDatabase(dbid);
+      if (vocbase == nullptr) return {};
+      auto col = vocbase->lookupCollection(cid);
+      if (col == nullptr) return {};
+      std::string out = col->name();
+      auto idx = col->lookupIndex(iid);
+      if (idx != nullptr) {
+        // Label as collection.field(s), e.g. "Person.creationDate"; fall back to
+        // the index type ("Person.primary") when the index exposes no fields.
+        auto fieldPaths = idx->fieldNames();  // vector<vector<string>>
+        if (!fieldPaths.empty() && !fieldPaths[0].empty()) {
+          out += ".";
+          bool first = true;
+          for (auto const& path : fieldPaths) {
+            for (auto const& part : path) {
+              if (!first) out += ",";
+              first = false;
+              out += part;
+            }
+          }
+        } else {
+          out += ".";
+          out += idx->typeName();
+        }
+      }
+      return out;
+    }
+    auto [dbid, cid] = mapObjectToCollection(objectId);
+    if (dbid == 0 || cid.empty()) return {};
+    auto vocbase = df.useDatabase(dbid);
+    if (vocbase == nullptr) return {};
+    auto col = vocbase->lookupCollection(cid);
+    return col != nullptr ? col->name() : std::string{};
+  } catch (...) {
+    return {};
+  }
+}
