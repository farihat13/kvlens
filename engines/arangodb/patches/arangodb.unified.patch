+// Linear 1us buckets up to 10ms + one overflow bucket. All atomics, so it
+// updates lock-free from the read path. Recorded only when ARANGO_KV_STATS is also
+// on (that path supplies the timing); ARANGO_KV_HISTOGRAMS requires ARANGO_KV_STATS.
+struct KvLatencyHistogram {
+  static constexpr uint32_t kBucketWidth = 1;      // us per bucket
+  static constexpr uint32_t kNumBuckets = 10000;   // 0..10ms range
+  std::atomic<uint64_t> count{0};
+  std::atomic<uint64_t> sum{0};
+  std::atomic<uint64_t> min{UINT64_MAX};
+  std::atomic<uint64_t> max{0};
+  std::array<std::atomic<uint64_t>, kNumBuckets + 1> buckets{};
+
+  // CAS-loop min/max + linear bucket increment (lock-free).
+  void record(uint64_t us) noexcept {
+    count.fetch_add(1, std::memory_order_relaxed);
+    sum.fetch_add(us, std::memory_order_relaxed);
+    uint64_t cur = min.load(std::memory_order_relaxed);
+    while (us < cur &&
+           !min.compare_exchange_weak(cur, us, std::memory_order_relaxed)) {
+    }
+    cur = max.load(std::memory_order_relaxed);
+    while (us > cur &&
+           !max.compare_exchange_weak(cur, us, std::memory_order_relaxed)) {
+    }
+    uint32_t idx = static_cast<uint32_t>(us / kBucketWidth);
+    if (idx > kNumBuckets) {
+      idx = kNumBuckets;
+    }
+    buckets[idx].fetch_add(1, std::memory_order_relaxed);
+  }
+
+  void reset() noexcept {
+    count.store(0, std::memory_order_relaxed);
+    sum.store(0, std::memory_order_relaxed);
+    min.store(UINT64_MAX, std::memory_order_relaxed);
+    max.store(0, std::memory_order_relaxed);
+    for (uint32_t i = 0; i <= kNumBuckets; ++i) {
+      buckets[i].store(0, std::memory_order_relaxed);
+    }
+  }
+
+  // Emit {count, sum, min, max, p50/p75/p99/p999, bucket_width, num_buckets,
+  // overflow_count, buckets:[{lo,hi,count}]} — defined in RocksDBEngine.cpp.
+  void toVPack(velocypack::Builder& builder) const noexcept;
