   RocksDBSavePoint.cpp
@@ -67,11 +69,45 @@ add_library(arango_rocksdb STATIC
   SimpleRocksDBTransactionState.cpp
   SortedRowsStorageBackendRocksDB.cpp)
 
-if (USE_V8) 
+if (USE_V8)
   target_sources(arango_rocksdb PRIVATE
     RocksDBV8Functions.cpp)
 endif()
 
+# arangodb.unified.patch — KV instrumentation feature flags, named by layer to
+# match NebulaGraph's (so "KV_STATS" means the same engine-wrapper counter on both):
+#   -DARANGO_KV_TICKERS=ON     RocksDB native tickers + native histograms
+#                              (process-global; needs --rocksdb.enable-statistics)
+#   -DARANGO_KV_STATS=ON       engine-wrapper hand counters: get/seek/next/prev
+#                              count + found + time_us + bytes (no runtime flag)
+#   -DARANGO_KV_HISTOGRAMS=ON  engine-wrapper get/seek/next/prev latency histograms
+#                              (requires ARANGO_KV_STATS for the timing)
+# Each turns into a compile definition seen by the /_admin/kvstats handler, the
+# RocksDBEngine counters, and the wrapped read Methods (all in this target).
+foreach(_kvflag ARANGO_KV_TICKERS ARANGO_KV_STATS ARANGO_KV_HISTOGRAMS)
+  if(${_kvflag})
+    # RocksDBEngine.h adds member fields under ARANGO_KV_STATS / ARANGO_KV_HISTOGRAMS,
+    # so the class layout depends on the flags. PUBLIC propagates the define to
+    # targets that *link* arango_rocksdb (StorageEngine, Replication2, Methods, ...).
+    # CAVEAT: a few TUs include RocksDBEngine.h WITHOUT linking arango_rocksdb
+    # (IResearch*, V8Server/v8-vocbase, RestHandler/RestDumpHandler) and so compile
+    # the unflagged layout — a technical ODR mismatch. It is benign today only
+    # because those TUs touch no KV members (just pre-KV accessors like db(), and
+    # out-of-line methods resolved inside arango_rocksdb with the correct layout).
+    # For guaranteed ODR safety, promote these to a global add_compile_definitions()
+    # instead of PUBLIC link propagation.
+    target_compile_definitions(arango_rocksdb PUBLIC ${_kvflag})
+    message(STATUS "arangodb.unified.patch: ${_kvflag} enabled")
+  endif()
+endforeach()
+
+# ARANGO_KV_HISTOGRAMS records into the per-op timing captured by ARANGO_KV_STATS,
+# so it cannot stand alone (matches NebulaGraph's "ENABLE_KV_HISTOGRAMS requires
+# ENABLE_KV_STATS").
+if(ARANGO_KV_HISTOGRAMS AND NOT ARANGO_KV_STATS)
+  message(FATAL_ERROR "ARANGO_KV_HISTOGRAMS=ON requires ARANGO_KV_STATS=ON")
+endif()
+
 target_link_libraries(arango_rocksdb
   arango_cache
   arango_common_rest_handler
