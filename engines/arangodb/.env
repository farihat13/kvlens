# ============================================================
# ARANGODB WIRING CONFIGURATION (Immutable)
# ============================================================
# This file contains ArangoDB-specific paths and toolchain config.
# Paths are computed relative to this file, so they hold in any checkout.
#
# DO NOT put experiment knobs here (cache size, device names, IPs, etc.)
# The measured settings are in engines/env.sh.
# ============================================================

# Compute paths relative to this file's location
export MY_ARANGO_ROOTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source directory
export ARANGO_SRCDIR="${MY_ARANGO_ROOTDIR}/arangodb-3.12.8"

# Runtime directories
export ARANGO_RUNSDIR="${MY_ARANGO_ROOTDIR}/runs"
export ARANGO_LOGDIR="${MY_ARANGO_ROOTDIR}/logs"
export ARANGO_BINARYDIR="${MY_ARANGO_ROOTDIR}/bin"

# Data and query directories
export ARANGO_DATADIR="${MY_ARANGO_ROOTDIR}/data"
export ARANGO_QUERYDIR="${MY_ARANGO_ROOTDIR}/../queries/ldbc/arangodb"

# Scripts
export ARANGO_SCRIPTSDIR="${MY_ARANGO_ROOTDIR}/scripts"

# Default port
export ARANGO_PORT=8529
