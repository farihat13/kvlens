# ============================================================
# NEBULAGRAPH WIRING CONFIGURATION (Immutable)
# ============================================================
# This file contains NebulaGraph-specific paths and toolchain config.
# Paths are computed relative to this file, so they hold in any checkout.
#
# DO NOT put experiment knobs here (cache size, device names, IPs, etc.)
# The measured settings are in engines/env.sh.
# ============================================================

# Compute paths relative to this file's location
export MY_NEBULA_ROOTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source directories
export MY_NEBULA_SRCDIR="${MY_NEBULA_ROOTDIR}/nebula"
export MY_ROCKS_SRCDIR="${MY_NEBULA_ROOTDIR}/rocksdb"

# Runtime directories
export NEBULA_RUNSDIR="${MY_NEBULA_ROOTDIR}/runs"
export NEBULA_LOGDIR="${MY_NEBULA_ROOTDIR}/logs"
export NEBULA_BINARYDIR="${MY_NEBULA_ROOTDIR}/bin"

# Data and query directories
export NEBULA_DATADIR="${MY_NEBULA_ROOTDIR}/data"
export NEBULA_QUERYDIR="${MY_NEBULA_ROOTDIR}/../queries/ldbc/nebulagraph"

# Tools
export NEBULA_CONSOLE_DIR="${MY_NEBULA_ROOTDIR}/nebula-console"
export NEBULA_IMPORTER_DIR="${MY_NEBULA_ROOTDIR}/nebula-importer"

# Docker container name (wiring, not experiment-specific)
export MY_NEBULA_CONTAINER_NAME="nebula-dev"

# Analysis and scripts
export NEBULA_SCRIPTSDIR="${MY_NEBULA_ROOTDIR}/scripts"
