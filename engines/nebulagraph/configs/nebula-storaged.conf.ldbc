########## basics ##########
--daemonize=true
--pid_file=pids/nebula-storaged.pid
--local_config=true

########## logging ##########
--log_dir=logs
--minloglevel=0
--v=0
--logbufsecs=0
--redirect_stdout=true
--stdout_log_file=storaged-stdout.log
--stderr_log_file=storaged-stderr.log
--stderrthreshold=3
--timestamp_in_logfile_name=true

########## networking ##########
--meta_server_addrs=127.0.0.1:9559
--local_ip=127.0.0.1
--port=9779
--ws_ip=0.0.0.0
--ws_http_port=19779
--heartbeat_interval_secs=10

######### Raft #########
--raft_heartbeat_interval_secs=30
--raft_rpc_timeout_ms=500
--wal_ttl=14400

########## Disk ##########
--data_path=data/storage
--minimum_reserved_bytes=268435456

# RocksDB tuning for high-performance NVMe
# Specifies the block cache for a batch operation. in bytes. 16KB per operation
--rocksdb_batch_size=16384
# Specifies the block cache for BlockBasedTable. in megabytes.
# Allocate ~60GB for block cache (1/3 of 188GB RAM)
# Experiment config: 4 GB block cache
--rocksdb_block_cache=4096
# Disable page cache since we have large block cache
--disable_page_cache=false

# Use LZ4 for best CPU/compression balance
--rocksdb_compression=lz4
# Disable compression for L0/L1 (hot data), use LZ4 for upper levels
--rocksdb_compression_per_level=no:no:lz4:lz4:lz4:lz4

############## rocksdb Options ##############
# High parallelism for NVMe: 16 background jobs, 8 subcompactions
# Increase background jobs to parallelize compaction
--rocksdb_db_options={"max_background_jobs":"32","max_open_files":"65536","stats_dump_period_sec":"300","writable_file_max_buffer_size":"2097152"}

# Large write buffers and aggressive compaction for write-heavy workload
# Reduce compaction overhead - more aggressive settings
# Increase write buffer size to 512MB, 8 write buffers
--rocksdb_column_family_options={"write_buffer_size":"536870912","max_write_buffer_number":"8","level0_file_num_compaction_trigger":"4","level0_slowdown_writes_trigger":"12","level0_stop_writes_trigger":"24","max_bytes_for_level_base":"2147483648","target_file_size_base":"268435456","disable_auto_compactions":"false"}

# Larger block size for sequential scan performance
--rocksdb_block_based_table_options={"block_size":"8192"}

# Experiment config: full RocksDB statistics enabled for profiling
--enable_rocksdb_statistics=true
--rocksdb_stats_level=kAll
--enable_rocksdb_prefix_filtering=true
--enable_rocksdb_whole_key_filtering=false

############### misc ####################
--query_concurrently=true
--auto_remove_invalid_space=true
# Use 24 IO threads for network handling
--num_io_threads=64
--num_max_connections=0
# Use 48 worker threads for request processing
--num_worker_threads=128
# Higher concurrency for admin jobs
--max_concurrent_subtasks=128
# Increase snapshot/rebuild rates for fast NVMe
--snapshot_part_rate_limit=104857600
--snapshot_batch_size=4194304
--rebuild_index_part_rate_limit=52428800
--rebuild_index_batch_size=4194304

########## memory tracker ##########
--memory_tracker_limit_ratio=0.75
--memory_tracker_untracked_reserved_memory_mb=2048
--memory_tracker_detail_log=false
--memory_tracker_detail_log_interval_ms=60000
--memory_purge_enabled=true
--memory_purge_interval_seconds=10
# Engine effect N4 Phase B (storaged-side) — see nebula.unified.patch.
# Routes IndexTopNNode → IndexLimitNode + reverse iterator when the
# orderBy column matches the index's first field, single-column
# orderBy, single index context, and no filter. Default false preserves
# stock heap-drain behavior. Set true to enable the fix for testing.
--fix_n4_storage_reverse_scan=true
