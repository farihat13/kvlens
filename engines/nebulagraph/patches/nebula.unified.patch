+using proxygen::ResponseBuilder;
+using proxygen::UpgradeProtocol;
+
+void StorageHttpKVStatsHandler::onRequest(std::unique_ptr<HTTPMessage> headers) noexcept {
+  if (action_ == Action::READ) {
+    if (headers->getMethod().value() != HTTPMethod::GET) {
+      resp_ = "Method not allowed. Use GET.";
+      err_ = HttpCode::E_UNSUPPORTED_METHOD;
+      return;
+    }
+    auto& c = kvstore::kvStatsCounters();
+    folly::dynamic obj = folly::dynamic::object
+        ("get_count", c.get_count.load(std::memory_order_relaxed))
+        ("get_found_count", c.get_found_count.load(std::memory_order_relaxed))
+        ("get_latency_ns", c.get_latency_ns.load(std::memory_order_relaxed))
+        ("get_bytes", c.get_bytes.load(std::memory_order_relaxed))
+        ("multi_get_count", c.multi_get_count.load(std::memory_order_relaxed))
+        ("multi_get_latency_ns", c.multi_get_latency_ns.load(std::memory_order_relaxed))
+        ("multi_get_keys", c.multi_get_keys.load(std::memory_order_relaxed))
+        ("multi_get_bytes", c.multi_get_bytes.load(std::memory_order_relaxed))
+        ("put_count", c.put_count.load(std::memory_order_relaxed))
+        ("put_latency_ns", c.put_latency_ns.load(std::memory_order_relaxed))
+        ("put_bytes", c.put_bytes.load(std::memory_order_relaxed))
+        ("multi_put_count", c.multi_put_count.load(std::memory_order_relaxed))
+        ("multi_put_latency_ns", c.multi_put_latency_ns.load(std::memory_order_relaxed))
+        ("multi_put_keys", c.multi_put_keys.load(std::memory_order_relaxed))
+        ("multi_put_bytes", c.multi_put_bytes.load(std::memory_order_relaxed))
+        ("remove_count", c.remove_count.load(std::memory_order_relaxed))
+        ("remove_latency_ns", c.remove_latency_ns.load(std::memory_order_relaxed))
+        ("remove_bytes", c.remove_bytes.load(std::memory_order_relaxed))
+        ("multi_remove_count", c.multi_remove_count.load(std::memory_order_relaxed))
+        ("multi_remove_latency_ns", c.multi_remove_latency_ns.load(std::memory_order_relaxed))
+        ("multi_remove_keys", c.multi_remove_keys.load(std::memory_order_relaxed))
+        ("multi_remove_bytes", c.multi_remove_bytes.load(std::memory_order_relaxed))
+        ("remove_range_count", c.remove_range_count.load(std::memory_order_relaxed))
+        ("remove_range_latency_ns", c.remove_range_latency_ns.load(std::memory_order_relaxed))
+        ("range_count", c.range_count.load(std::memory_order_relaxed))
+        ("range_latency_ns", c.range_latency_ns.load(std::memory_order_relaxed))
+        ("prefix_count", c.prefix_count.load(std::memory_order_relaxed))
+        ("prefix_latency_ns", c.prefix_latency_ns.load(std::memory_order_relaxed))
+        ("range_with_prefix_count", c.range_with_prefix_count.load(std::memory_order_relaxed))
+        ("range_with_prefix_latency_ns", c.range_with_prefix_latency_ns.load(std::memory_order_relaxed))
+        ("scan_count", c.scan_count.load(std::memory_order_relaxed))
+        ("scan_latency_ns", c.scan_latency_ns.load(std::memory_order_relaxed))
+        ("commit_batch_write_count", c.commit_batch_write_count.load(std::memory_order_relaxed))
+        ("commit_batch_write_latency_ns", c.commit_batch_write_latency_ns.load(std::memory_order_relaxed))
+        ("iterator_next_count", c.iterator_next_count.load(std::memory_order_relaxed))
+        ("iterator_next_latency_ns", c.iterator_next_latency_ns.load(std::memory_order_relaxed))
+        ("iterator_next_bytes", c.iterator_next_bytes.load(std::memory_order_relaxed))
+        ("iterator_prev_count", c.iterator_prev_count.load(std::memory_order_relaxed))
+        ("iterator_prev_latency_ns", c.iterator_prev_latency_ns.load(std::memory_order_relaxed))
+        ("iterator_prev_bytes", c.iterator_prev_bytes.load(std::memory_order_relaxed))
+        ("wb_put_count", c.wb_put_count.load(std::memory_order_relaxed))
+        ("wb_remove_count", c.wb_remove_count.load(std::memory_order_relaxed))
+        ("wb_remove_range_count", c.wb_remove_range_count.load(std::memory_order_relaxed));
+#ifdef KV_HISTOGRAMS
+    obj["histograms"] = kvstore::kvHistograms().toJson();
+#endif
+    resp_ = folly::toPrettyJson(obj);
+  } else if (action_ == Action::RESET) {
+    auto method = headers->getMethod().value();
+    if (method != HTTPMethod::PUT && method != HTTPMethod::POST) {
+      resp_ = "Method not allowed. Use PUT or POST.";
+      err_ = HttpCode::E_UNSUPPORTED_METHOD;
+      return;
+    }
+    kvstore::kvStatsCounters().reset();
+#ifdef KV_HISTOGRAMS
+    kvstore::kvHistograms().reset();
+#endif
+    resp_ = "{\"status\":\"ok\"}";
+  } else if (action_ == Action::TRACE_ENABLE) {
+    size_t maxEntries = 100000;  // default when ?max= is absent
+    if (headers->hasQueryParam("max")) {
+      try {
+        maxEntries = std::stoul(headers->getQueryParam("max"));
+      } catch (const std::exception&) {
+        resp_ = "{\"status\":\"error\",\"message\":\"invalid max parameter\"}";
+        err_ = HttpCode::E_ILLEGAL_ARGUMENT;
+        return;
+      }
+    }
+    kvstore::kvStatsCounters().traceEnable(maxEntries);
+    resp_ = "{\"status\":\"ok\",\"message\":\"KV trace enabled\",\"max\":" +
+            std::to_string(maxEntries) + "}";
+  } else if (action_ == Action::TRACE_DISABLE) {
+    kvstore::kvStatsCounters().traceDisable();
+    resp_ = "{\"status\":\"ok\",\"message\":\"KV trace disabled\"}";
+  } else if (action_ == Action::TRACE_READ) {
+    auto& c = kvstore::kvStatsCounters();
+    folly::dynamic arr = folly::dynamic::array;
+    {
+      std::lock_guard<std::mutex> lock(c.trace_mutex);
+      for (const auto& e : c.trace_buffer) {
+        arr.push_back(folly::dynamic::object
+            ("op", e.op)
+            ("key", e.key_hex)
+            ("key_size", e.key_size)
+            ("value_size", e.value_size));
+      }
+    }
+    folly::dynamic obj = folly::dynamic::object
+        ("count", arr.size())
+        ("enabled", c.trace_enabled.load(std::memory_order_relaxed))
+        ("entries", arr);
+    resp_ = folly::toPrettyJson(obj);
+  }
+}
+
+void StorageHttpKVStatsHandler::onBody(std::unique_ptr<folly::IOBuf>) noexcept {
+  // Nothing to do
+}
+
+void StorageHttpKVStatsHandler::onEOM() noexcept {
+  switch (err_) {
+    case HttpCode::E_UNSUPPORTED_METHOD:
+      ResponseBuilder(downstream_).status(405, "Method not allowed").body(resp_).sendWithEOM();
+      return;
+    case HttpCode::E_ILLEGAL_ARGUMENT:
+      ResponseBuilder(downstream_).status(400, "Bad request").body(resp_).sendWithEOM();
+      return;
+    default:
+      break;
+  }
+  ResponseBuilder(downstream_)
+      .status(200, "OK")
+      .header("Content-Type", "application/json")
+      .body(resp_)
+      .sendWithEOM();
+}
+
+void StorageHttpKVStatsHandler::onUpgrade(UpgradeProtocol) noexcept {
+  // Do nothing
+}
+
+void StorageHttpKVStatsHandler::requestComplete() noexcept {
+  delete this;
+}
+
+void StorageHttpKVStatsHandler::onError(ProxygenError error) noexcept {
+  LOG(ERROR) << "Web service StorageHttpKVStatsHandler got error: "
+             << proxygen::getErrorString(error);
+  delete this;
+}
+
+}  // namespace storage
+}  // namespace nebula
+
+#endif  // KV_STATS
