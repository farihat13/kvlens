+#ifndef STORAGE_HTTP_STORAGEHTTPKVSTATSHANDLER_H_
+#define STORAGE_HTTP_STORAGEHTTPKVSTATSHANDLER_H_
+
+#ifdef KV_STATS
+
+#include <proxygen/httpserver/RequestHandler.h>
+
+#include "common/base/Base.h"
+#include "webservice/Common.h"
+
+namespace nebula {
+namespace storage {
+
+/**
+ * @brief HTTP handler for /kvstats endpoint.
+ *
+ * GET  /kvstats       — returns all cumulative atomic KV counters as flat JSON
+ * PUT  /kvstats/reset — zeros all counters and returns {"status":"ok"}
+ */
+class StorageHttpKVStatsHandler : public proxygen::RequestHandler {
+ public:
+  enum class Action { READ, RESET, TRACE_ENABLE, TRACE_DISABLE, TRACE_READ };
+
+  explicit StorageHttpKVStatsHandler(Action action) : action_(action) {}
+
+  void onRequest(std::unique_ptr<proxygen::HTTPMessage> headers) noexcept override;
+  void onBody(std::unique_ptr<folly::IOBuf> body) noexcept override;
+  void onEOM() noexcept override;
+  void onUpgrade(proxygen::UpgradeProtocol proto) noexcept override;
+  void requestComplete() noexcept override;
+  void onError(proxygen::ProxygenError err) noexcept override;
+
+ private:
+  Action action_;
+  HttpCode err_{HttpCode::SUCCEEDED};
+  std::string resp_;
+};
+
+}  // namespace storage
+}  // namespace nebula
+
+#endif  // KV_STATS
+#endif  // STORAGE_HTTP_STORAGEHTTPKVSTATSHANDLER_H_
