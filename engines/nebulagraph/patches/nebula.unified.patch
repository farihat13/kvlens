+#ifdef KV_HISTOGRAMS
+void ResettableHistogram::record(uint64_t val) {
+  count.fetch_add(1, std::memory_order_relaxed);
+  sum.fetch_add(val, std::memory_order_relaxed);
+  // Update min (CAS loop)
+  uint64_t cur = min.load(std::memory_order_relaxed);
+  while (val < cur && !min.compare_exchange_weak(cur, val, std::memory_order_relaxed)) {}
+  // Update max (CAS loop)
+  cur = max.load(std::memory_order_relaxed);
+  while (val > cur && !max.compare_exchange_weak(cur, val, std::memory_order_relaxed)) {}
+  uint32_t idx = static_cast<uint32_t>(val / bucket_width);
+  if (idx > num_buckets) idx = num_buckets;
+  buckets[idx].fetch_add(1, std::memory_order_relaxed);
+}
+
+void ResettableHistogram::reset() {
+  count.store(0, std::memory_order_relaxed);
+  sum.store(0, std::memory_order_relaxed);
+  min.store(UINT64_MAX, std::memory_order_relaxed);
+  max.store(0, std::memory_order_relaxed);
+  for (uint32_t i = 0; i <= num_buckets; ++i) {
+    buckets[i].store(0, std::memory_order_relaxed);
+  }
+}
+
+uint64_t ResettableHistogram::percentile(double pct) const {
+  uint64_t total = count.load(std::memory_order_relaxed);
+  if (total == 0) return 0;
+  uint64_t threshold = static_cast<uint64_t>(total * pct);
+  if (threshold == 0) threshold = 1;
+  uint64_t cumulative = 0;
+  for (uint32_t i = 0; i <= num_buckets; ++i) {
+    cumulative += buckets[i].load(std::memory_order_relaxed);
+    if (cumulative >= threshold) {
+      return static_cast<uint64_t>(i + 1) * bucket_width;
+    }
+  }
+  return static_cast<uint64_t>(num_buckets) * bucket_width;
+}
+
+folly::dynamic ResettableHistogram::toJson() const {
+  uint64_t n = count.load(std::memory_order_relaxed);
+  uint64_t minVal = min.load(std::memory_order_relaxed);
+  uint64_t maxVal = max.load(std::memory_order_relaxed);
+  return folly::dynamic::object
+      ("count", n)
+      ("sum", sum.load(std::memory_order_relaxed))
+      ("min", n > 0 ? minVal : 0)
+      ("max", maxVal)
+      ("p50", percentile(0.50))
+      ("p75", percentile(0.75))
+      ("p99", percentile(0.99))
+      ("p999", percentile(0.999));
+}
+
+void KVHistograms::reset() {
+  get_latency.reset();
+  multiget_latency.reset();
+  seek_latency.reset();
+  next_latency.reset();
+  get_size.reset();
+  next_size.reset();
+}
+
+folly::dynamic KVHistograms::toJson() const {
+  return folly::dynamic::object
+      ("get_latency", get_latency.toJson())
+      ("multiget_latency", multiget_latency.toJson())
+      ("seek_latency", seek_latency.toJson())
+      ("next_latency", next_latency.toJson())
+      ("get_size", get_size.toJson())
+      ("next_size", next_size.toJson());
+}
+
+static KVHistograms sKVHistograms;
+
+KVHistograms& kvHistograms() {
+  return sKVHistograms;
+}
+#endif
