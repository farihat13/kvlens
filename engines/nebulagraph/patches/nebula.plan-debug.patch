+        ("multi_get_latency_us", c.multi_get_latency_us.load(std::memory_order_relaxed))
+        ("multi_get_keys", c.multi_get_keys.load(std::memory_order_relaxed))
+        ("multi_get_bytes", c.multi_get_bytes.load(std::memory_order_relaxed))
+        ("put_count", c.put_count.load(std::memory_order_relaxed))
+        ("put_latency_us", c.put_latency_us.load(std::memory_order_relaxed))
+        ("put_bytes", c.put_bytes.load(std::memory_order_relaxed))
+        ("multi_put_count", c.multi_put_count.load(std::memory_order_relaxed))
+        ("multi_put_latency_us", c.multi_put_latency_us.load(std::memory_order_relaxed))
+        ("multi_put_keys", c.multi_put_keys.load(std::memory_order_relaxed))
+        ("multi_put_bytes", c.multi_put_bytes.load(std::memory_order_relaxed))
+        ("remove_count", c.remove_count.load(std::memory_order_relaxed))
+        ("remove_latency_us", c.remove_latency_us.load(std::memory_order_relaxed))
+        ("remove_bytes", c.remove_bytes.load(std::memory_order_relaxed))
+        ("multi_remove_count", c.multi_remove_count.load(std::memory_order_relaxed))
+        ("multi_remove_latency_us", c.multi_remove_latency_us.load(std::memory_order_relaxed))
+        ("multi_remove_keys", c.multi_remove_keys.load(std::memory_order_relaxed))
+        ("multi_remove_bytes", c.multi_remove_bytes.load(std::memory_order_relaxed))
+        ("remove_range_count", c.remove_range_count.load(std::memory_order_relaxed))
+        ("remove_range_latency_us", c.remove_range_latency_us.load(std::memory_order_relaxed))
+        ("range_count", c.range_count.load(std::memory_order_relaxed))
+        ("range_latency_us", c.range_latency_us.load(std::memory_order_relaxed))
+        ("prefix_count", c.prefix_count.load(std::memory_order_relaxed))
+        ("prefix_latency_us", c.prefix_latency_us.load(std::memory_order_relaxed))
+        ("range_with_prefix_count", c.range_with_prefix_count.load(std::memory_order_relaxed))
+        ("range_with_prefix_latency_us", c.range_with_prefix_latency_us.load(std::memory_order_relaxed))
+        ("scan_count", c.scan_count.load(std::memory_order_relaxed))
+        ("scan_latency_us", c.scan_latency_us.load(std::memory_order_relaxed))
+        ("commit_batch_write_count", c.commit_batch_write_count.load(std::memory_order_relaxed))
+        ("commit_batch_write_latency_us", c.commit_batch_write_latency_us.load(std::memory_order_relaxed))
+        ("iterator_next_count", c.iterator_next_count.load(std::memory_order_relaxed))
+        ("iterator_next_latency_us", c.iterator_next_latency_us.load(std::memory_order_relaxed))
+        ("iterator_next_bytes", c.iterator_next_bytes.load(std::memory_order_relaxed))
+        ("iterator_prev_count", c.iterator_prev_count.load(std::memory_order_relaxed))
+        ("iterator_prev_latency_us", c.iterator_prev_latency_us.load(std::memory_order_relaxed))
+        ("iterator_prev_bytes", c.iterator_prev_bytes.load(std::memory_order_relaxed))
+        ("wb_put_count", c.wb_put_count.load(std::memory_order_relaxed))
+        ("wb_remove_count", c.wb_remove_count.load(std::memory_order_relaxed))
+        ("wb_remove_range_count", c.wb_remove_range_count.load(std::memory_order_relaxed));
+    resp_ = folly::toPrettyJson(obj);
+  } else {
+    // RESET action — accept PUT or POST
+    auto method = headers->getMethod().value();
+    if (method != HTTPMethod::PUT && method != HTTPMethod::POST) {
+      resp_ = "Method not allowed. Use PUT or POST.";
+      err_ = HttpCode::E_UNSUPPORTED_METHOD;
+      return;
+    }
+    kvstore::kvStatsCounters().reset();
+    resp_ = "{\"status\":\"ok\"}";
+  }
+}
+
+void StorageHttpKVStatsHandler::onBody(std::unique_ptr<folly::IOBuf>) noexcept {
+  // Nothing to do
+}
+
+void StorageHttpKVStatsHandler::onEOM() noexcept {
+  switch (err_) {
+    case HttpCode::E_UNSUPPORTED_METHOD:
+      ResponseBuilder(downstream_).status(405, "Method not allowed").body(resp_).sendWithEOM();
+      return;
+    case HttpCode::E_ILLEGAL_ARGUMENT:
+      ResponseBuilder(downstream_).status(400, "Bad request").body(resp_).sendWithEOM();
+      return;
+    default:
+      break;
+  }
+  ResponseBuilder(downstream_)
+      .status(200, "OK")
+      .header("Content-Type", "application/json")
+      .body(resp_)
+      .sendWithEOM();
+}
+
+void StorageHttpKVStatsHandler::onUpgrade(UpgradeProtocol) noexcept {
+  // Do nothing
+}
+
+void StorageHttpKVStatsHandler::requestComplete() noexcept {
+  delete this;
+}
+
+void StorageHttpKVStatsHandler::onError(ProxygenError error) noexcept {
+  LOG(ERROR) << "Web service StorageHttpKVStatsHandler got error: "
+             << proxygen::getErrorString(error);
+  delete this;
+}
+
+}  // namespace storage
+}  // namespace nebula
+
+#endif  // KV_STATS
