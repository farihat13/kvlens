########## basics ##########
--daemonize=true
--pid_file=pids/nebula-storaged.pid
--local_config=true

########## logging ##########
--log_dir=logs
--minloglevel=0
--v=0
--logbufsecs=0
--redirect_stdout=true
--stdout_log_file=storaged-stdout.log
--stderr_log_file=storaged-stderr.log
--stderrthreshold=3
--timestamp_in_logfile_name=true

########## networking ##########
--meta_server_addrs=127.0.0.1:9559
--local_ip=127.0.0.1
--port=9779
--ws_ip=0.0.0.0
--ws_http_port=19779
--heartbeat_interval_secs=10

######### Raft #########
--raft_heartbeat_interval_secs=30
--raft_rpc_timeout_ms=500
--wal_ttl=14400

########## Disk ##########
--data_path=data/storage
--minimum_reserved_bytes=268435456

# RocksDB tuning - 1GB cache constraint (comparable to DGraph)
--rocksdb_batch_size=16384

# CRITICAL: Set block cache to 1GB (1024 MB)
--rocksdb_block_cache=1024

# Disable page cache to avoid competition with block cache
--disable_page_cache=true

# Use LZ4 for best CPU/compression balance
--rocksdb_compression=lz4
# Disable compression for L0/L1 (hot data), use LZ4 for upper levels
--rocksdb_compression_per_level=no:no:lz4:lz4:lz4:lz4

############## rocksdb Options ##############
--rocksdb_db_options={"max_background_jobs":"16","max_open_files":"32768","stats_dump_period_sec":"300","writable_file_max_buffer_size":"1048576"}

# CRITICAL: Reduce write buffers to not compete with 1GB cache
# With 1GB cache, use smaller write buffers (64MB each, max 512MB total)
--rocksdb_column_family_options={"write_buffer_size":"67108864","max_write_buffer_number":"8","level0_file_num_compaction_trigger":"4","level0_slowdown_writes_trigger":"20","level0_stop_writes_trigger":"40","max_bytes_for_level_base":"268435456","target_file_size_base":"67108864","disable_auto_compactions":"false"}

# Block-based table options - ensure cache is used efficiently
--rocksdb_block_based_table_options={"block_size":"16384"}

# Enable statistics to monitor cache effectiveness
--enable_rocksdb_statistics=false
--rocksdb_stats_level=kExceptHistogramOrTimers
--enable_rocksdb_prefix_filtering=true
--enable_rocksdb_whole_key_filtering=false

############### misc ####################
--query_concurrently=true
--auto_remove_invalid_space=true
# Use 24 IO threads for network handling
--num_io_threads=24
--num_max_connections=10000
# Use 48 worker threads for request processing
--num_worker_threads=48
# Higher concurrency for admin jobs
--max_concurrent_subtasks=32

# Moderate snapshot rates (not critical for read-heavy benchmarks)
--snapshot_part_rate_limit=52428800
--snapshot_batch_size=2097152
--rebuild_index_part_rate_limit=26214400
--rebuild_index_batch_size=2097152

########## memory tracker ##########
# Adjust for small cache - don't throttle prematurely
--memory_tracker_limit_ratio=0.85
--memory_tracker_untracked_reserved_memory_mb=1024
--memory_tracker_detail_log=false
--memory_tracker_detail_log_interval_ms=60000
--memory_purge_enabled=true
--memory_purge_interval_seconds=10