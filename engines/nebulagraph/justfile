# Run a single query from string, e.g., `just q "MATCH (v) RETURN v;" --space demo_space --pretty`
q query *args:
    python3 ../../python/kvengines/nebula/query_run.py -s "{{query}}" {{args}}

# Run queries from a file, e.g., `just qfile queries/test.gql --space demo_space`
qfile file *args:
    python3 ../../python/kvengines/nebula/query_run.py -f {{file}} {{args}}

# =============================
# LDBC SNB Interactive
# =============================

# Run a single LDBC interactive-complex query
ldbc-icq q="1" param="1":
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py --num {{q}} --param {{param}} -v

# Run all LDBC interactive-complex queries
ldbc-ic:
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py --all --nparam 35 -c

# Run all LDBC interactive-short queries
ldbc-short:
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py -qt short --all -c

# Run a single LDBC interactive-short query
ldbc-isq q="1":
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py -qt short --num {{q}} --nparam 20 --show-raw

# Compare two query variants for equivalence
check-qeq q="1" nparam="1":
    python3 -u ../../python/kvengines/nebula/query_check_equivalence.py \
    --query1 queries/interactive-complex-{{q}}.gql \
    --query2 queries/interactive-complex-{{q}}.v2.gql \
    --params data/ldbc/substitution_parameters-sf0.3/interactive_{{q}}_param.txt \
    --nparam {{nparam}} \
    --continue \
    --save-report logs/ic{{q}}_comparison.json

