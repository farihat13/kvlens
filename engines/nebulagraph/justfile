# Run all IC queries with PROFILE
ldbc-ic-profile:
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py --all --nparam 35 -c --profile

# Run all IC queries with hooks (metrics collection)
ldbc-ic-collect:
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py --all --nparam 35 --hooks

ldbc-icq-profile q="1":
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py --num {{q}} --nparam 35 -c --profile

ldbc-icq-explain q="1":
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py --num {{q}} --nparam 1 -c --explain -v

ldbc-icq-collect q="1" nparam="1":
    python3 -u ../../python/kvengines/nebula/ldbc/run_ldbc.py --num {{q}} --nparam {{nparam}} --hooks

warmup:
    just ldbc-ic > warmup.log 2>&1

# Measure kvstore time and query time with profiling enabled
ldbc-icq-seqrun:
    echo "warmup..."
    just ldbc-ic > ic.log 2>&1
    echo "profile run..."
    just ldbc-ic-profile > profile.log 2>&1
    echo "extract plan metrics..."
    python3 -u ../../python/kvengines/nebula/extract_plan_metrics.py -v > plan.log 2>&1
    mv logs/nebula_plan_metrics.csv logs/nebula-icq-seqrun_$(date +%Y%m%d_%H%M%S).csv

# =============================
# Plan Inspection
# =============================

# Set storage debug flags, run a single query, and parse plan output
storage-plan-query q='1' param='1' level='1':
    #!/bin/bash
    set -euo pipefail
    curl -s -X PUT http://localhost:19779/flags \
      -d '{"storage_log_level": "{{level}}", "query_concurrently": "false", "num_worker_threads": "1"}'
    LOG=runs/logs/nebula-storaged.INFO
    truncate -s 0 "$LOG"
    just ldbc-icq {{q}} {{param}}
    outdir="logs/storage-plan-level{{level}}/ic{{q}}/p{{param}}"
    mkdir -p "$outdir"
    cp "$LOG" "$outdir/storaged.log"
    echo "Raw log saved to $outdir/storaged.log ($(wc -l < "$outdir/storaged.log") lines)"
    python3 -u ../../python/kvengines/nebula/parse_storage_plan_log.py "$outdir/storaged.log"

# Reset storage debug flags and restore concurrency
storage-plan-off:
    curl -s -X PUT http://localhost:19779/flags -d '{"storage_log_level": "0", "query_concurrently": "true", "num_worker_threads": "128"}'

# Run PROFILE on a query file and generate plan figures
plan-query file *args:
    python3 -u ../../python/kvengines/nebula/plan_query.py -f {{file}} {{args}}

# Re-analyze a saved plan.txt (no DB connection needed)
plan-analyze file *args:
    python3 -u ../../python/kvengines/nebula/plan_query.py --from-saved {{file}} {{args}}

# =============================
# Metrics
# =============================

# Snapshot metrics before an experiment
before:
    just storage-stats > 0storage.log
    just graph-stats > 0graph.log
    just meta-stats > 0meta.log
    just rocksdb-stats > 0rocksdb.log

# Snapshot metrics after an experiment
after:
    just storage-stats > 1storage.log
    just graph-stats > 1graph.log
    just meta-stats > 1meta.log
    just rocksdb-stats > 1rocksdb.log

# RocksDB statistics (storage layer)
rocksdb-stats:
    curl -s http://127.0.0.1:19779/rocksdb_stats | sort

# Storage service stats/metrics
storage-stats:
    curl -s http://127.0.0.1:19779/stats | sort

# Graph service stats (port 19669)
graph-stats:
    curl -s http://127.0.0.1:19669/stats | sort

# Meta service stats (port 19559)
meta-stats:
    curl -s http://127.0.0.1:19559/stats | sort

kvstats:
    curl -s http://localhost:19779/kvstats
reset-kvstats:
    curl -s -X PUT http://localhost:19779/kvstats/reset

