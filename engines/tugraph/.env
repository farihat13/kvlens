# TuGraph wiring: paths and ports, computed from this file's place. No measured setting here (those: engines/env.sh).
export TUGRAPH_ROOTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TUGRAPH_VERSION=4.5.2
# the release package, unpacked by get.sh (bin/lgraph_server, bin/lgraph_import, lib64/lgraph/liblgraph.so)
export TUGRAPH_HOME="${TUGRAPH_ROOTDIR}/tugraph-${TUGRAPH_VERSION}/usr/local"
export TUGRAPH_BINARYDIR="${TUGRAPH_ROOTDIR}/bin"          # our counter library, from build.sh
export TUGRAPH_RUNSDIR="${TUGRAPH_ROOTDIR}/runs"           # the running server's data dir, config and logs
export TUGRAPH_PORT=7070                                   # REST: POST /login, POST /cypher
export TUGRAPH_KVSTATS_PORT=7072                           # the counters: GET /kvstats, PUT /kvstats/reset
export TUGRAPH_USER=admin
export TUGRAPH_PASSWORD='73@TuGraph'                       # the release's default; the server listens on 127.0.0.1 only
