{
 "about": "TuGraph's physical design for LDBC SNB, as lgraph_import reads it: the labels, ids and properties the other databases load (engines/nebulagraph/schema/schema.gql), LDBC's ids as each label's primary key, and four secondary indexes (Person.firstName, Place.name, Tag.name, TagClass.name). TuGraph has no list property, so a person's emails and languages are one string each, joined by ';' (scripts/prepare_import.py writes prepared/person.csv). Paths are relative to LDBC's CsvBasic directory; prepare_import.py makes them absolute and sets every label's detach_property.",
 "schema": [
  {"label": "Person", "type": "VERTEX", "primary": "id", "properties": [{"name": "id", "type": "INT64"}, {"name": "firstName", "type": "STRING", "index": true}, {"name": "lastName", "type": "STRING"}, {"name": "gender", "type": "STRING"}, {"name": "birthday", "type": "INT64"}, {"name": "creationDate", "type": "INT64"}, {"name": "locationIP", "type": "STRING"}, {"name": "browserUsed", "type": "STRING"}, {"name": "emails", "type": "STRING", "optional": true}, {"name": "languages", "type": "STRING", "optional": true}]},
  {"label": "Post", "type": "VERTEX", "primary": "id", "properties": [{"name": "id", "type": "INT64"}, {"name": "imageFile", "type": "STRING", "optional": true}, {"name": "creationDate", "type": "INT64"}, {"name": "locationIP", "type": "STRING"}, {"name": "browserUsed", "type": "STRING"}, {"name": "language", "type": "STRING", "optional": true}, {"name": "content", "type": "STRING", "optional": true}, {"name": "length", "type": "INT32"}]},
  {"label": "Comment", "type": "VERTEX", "primary": "id", "properties": [{"name": "id", "type": "INT64"}, {"name": "creationDate", "type": "INT64"}, {"name": "locationIP", "type": "STRING"}, {"name": "browserUsed", "type": "STRING"}, {"name": "content", "type": "STRING", "optional": true}, {"name": "length", "type": "INT32"}]},
  {"label": "Forum", "type": "VERTEX", "primary": "id", "properties": [{"name": "id", "type": "INT64"}, {"name": "title", "type": "STRING"}, {"name": "creationDate", "type": "INT64"}]},
  {"label": "Organisation", "type": "VERTEX", "primary": "id", "properties": [{"name": "id", "type": "INT64"}, {"name": "type", "type": "STRING"}, {"name": "name", "type": "STRING"}, {"name": "url", "type": "STRING"}]},
  {"label": "Place", "type": "VERTEX", "primary": "id", "properties": [{"name": "id", "type": "INT64"}, {"name": "name", "type": "STRING", "index": true}, {"name": "url", "type": "STRING"}, {"name": "type", "type": "STRING"}]},
  {"label": "Tag", "type": "VERTEX", "primary": "id", "properties": [{"name": "id", "type": "INT64"}, {"name": "name", "type": "STRING", "index": true}, {"name": "url", "type": "STRING"}]},
  {"label": "TagClass", "type": "VERTEX", "primary": "id", "properties": [{"name": "id", "type": "INT64"}, {"name": "name", "type": "STRING", "index": true}, {"name": "url", "type": "STRING"}]},
  {"label": "KNOWS", "type": "EDGE", "constraints": [["Person", "Person"]], "properties": [{"name": "creationDate", "type": "INT64"}]},
  {"label": "IS_LOCATED_IN", "type": "EDGE", "constraints": [["Person", "Place"], ["Post", "Place"], ["Comment", "Place"], ["Organisation", "Place"]]},
  {"label": "HAS_CREATOR", "type": "EDGE", "constraints": [["Post", "Person"], ["Comment", "Person"]]},
  {"label": "STUDY_AT", "type": "EDGE", "constraints": [["Person", "Organisation"]], "properties": [{"name": "classYear", "type": "INT32"}]},
  {"label": "WORK_AT", "type": "EDGE", "constraints": [["Person", "Organisation"]], "properties": [{"name": "workFrom", "type": "INT32"}]},
  {"label": "HAS_INTEREST", "type": "EDGE", "constraints": [["Person", "Tag"]]},
  {"label": "LIKES", "type": "EDGE", "constraints": [["Person", "Post"], ["Person", "Comment"]], "properties": [{"name": "creationDate", "type": "INT64"}]},
  {"label": "HAS_TAG", "type": "EDGE", "constraints": [["Post", "Tag"], ["Comment", "Tag"], ["Forum", "Tag"]]},
  {"label": "HAS_MEMBER", "type": "EDGE", "constraints": [["Forum", "Person"]], "properties": [{"name": "joinDate", "type": "INT64"}]},
  {"label": "HAS_MODERATOR", "type": "EDGE", "constraints": [["Forum", "Person"]]},
  {"label": "CONTAINER_OF", "type": "EDGE", "constraints": [["Forum", "Post"]]},
  {"label": "REPLY_OF", "type": "EDGE", "constraints": [["Comment", "Post"], ["Comment", "Comment"]]},
  {"label": "IS_PART_OF", "type": "EDGE", "constraints": [["Place", "Place"]]},
  {"label": "HAS_TYPE", "type": "EDGE", "constraints": [["Tag", "TagClass"]]},
  {"label": "IS_SUBCLASS_OF", "type": "EDGE", "constraints": [["TagClass", "TagClass"]]}
 ],
