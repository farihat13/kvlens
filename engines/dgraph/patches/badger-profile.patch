diff --git dgraph/badger/y/functrace.go dgraph/badger/y/functrace.go
new file mode 100644
index 000000000..4b6564830
--- /dev/null
+++ dgraph/badger/y/functrace.go
@@ -0,0 +1,49 @@
+//go:build functrace
+
+package y
+
+import (
+	"sync/atomic"
+)
+
+// FuncCounter tracks function call counts
+type FuncCounter struct {
+	name  string
+	count *uint64
+}
+
+var (
+	// Registry of all function counters
+	funcCounters = make(map[string]*uint64)
+)
+
+func Enabled() bool { return false }
+
+// RegisterFuncCounter creates a new counter for a function
+func RegisterFuncCounter(name string) *uint64 {
+	counter := new(uint64)
+	funcCounters[name] = counter
+	return counter
+}
+
+// GetFuncCounts returns all current counts
+func GetFuncCounts() map[string]uint64 {
+	counts := make(map[string]uint64)
+	for name, counter := range funcCounters {
+		counts[name] = atomic.LoadUint64(counter)
+	}
+	return counts
+}
+
+// ResetFuncCounts resets all counters to zero
+func ResetFuncCounts() {
+	for _, counter := range funcCounters {
+		atomic.StoreUint64(counter, 0)
+	}
+}
+
+func Inc(counter *uint64) {
+	if counter != nil {
+		atomic.AddUint64(counter, 1)
+	}
+}
