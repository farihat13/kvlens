@@ -0,0 +1,103 @@
+//go:build kvstats
+
+package y
+
+import (
+	"encoding/json"
+	"sync/atomic"
+	"time"
+)
+
+var (
+	kvGetCount      int64
+	kvGetFoundCount int64
+	kvGetLatencyNs  int64
+	kvGetBytes      int64
+
+	kvSetCount     int64
+	kvSetLatencyNs int64
+	kvSetBytes     int64
+
+	kvSeekCount     int64
+	kvSeekLatencyNs int64
+	kvSeekBytes     int64
+
+	kvNextCount     int64
+	kvNextLatencyNs int64
+	kvNextBytes     int64
+)
+
+// KvRecordGet records a Get operation. If found, also records found count and bytes.
+func KvRecordGet(latency time.Duration, found bool, bytes int) {
+	atomic.AddInt64(&kvGetCount, 1)
+	atomic.AddInt64(&kvGetLatencyNs, latency.Nanoseconds())
+	if found {
+		atomic.AddInt64(&kvGetFoundCount, 1)
+		atomic.AddInt64(&kvGetBytes, int64(bytes))
+	}
+}
+
+// KvRecordSet records a Set operation with latency and bytes written.
+func KvRecordSet(latency time.Duration, bytes int) {
+	atomic.AddInt64(&kvSetCount, 1)
+	atomic.AddInt64(&kvSetLatencyNs, latency.Nanoseconds())
+	atomic.AddInt64(&kvSetBytes, int64(bytes))
+}
+
+// KvRecordSeek records a Seek operation with latency and bytes of the first
+// item loaded by prefetch. Seek positions the cursor AND prefetches the first
+// item, so its bytes must be counted here (Next only sees subsequent items).
+func KvRecordSeek(latency time.Duration, bytes int) {
+	atomic.AddInt64(&kvSeekCount, 1)
+	atomic.AddInt64(&kvSeekLatencyNs, latency.Nanoseconds())
+	atomic.AddInt64(&kvSeekBytes, int64(bytes))
+}
+
+// KvRecordNext records a Next operation with latency and bytes scanned.
+func KvRecordNext(latency time.Duration, bytes int) {
+	atomic.AddInt64(&kvNextCount, 1)
+	atomic.AddInt64(&kvNextLatencyNs, latency.Nanoseconds())
+	atomic.AddInt64(&kvNextBytes, int64(bytes))
+}
+
+// GetKvStats returns all counters as a flat map matching the JSON format
+// expected by the /kvstats endpoint.
+func GetKvStats() map[string]int64 {
+	return map[string]int64{
+		"get_count":       atomic.LoadInt64(&kvGetCount),
+		"get_found_count": atomic.LoadInt64(&kvGetFoundCount),
+		"get_latency_ns":  atomic.LoadInt64(&kvGetLatencyNs),
+		"get_bytes":       atomic.LoadInt64(&kvGetBytes),
+		"set_count":       atomic.LoadInt64(&kvSetCount),
+		"set_latency_ns":  atomic.LoadInt64(&kvSetLatencyNs),
+		"set_bytes":       atomic.LoadInt64(&kvSetBytes),
+		"seek_count":      atomic.LoadInt64(&kvSeekCount),
+		"seek_latency_ns": atomic.LoadInt64(&kvSeekLatencyNs),
+		"seek_bytes":      atomic.LoadInt64(&kvSeekBytes),
+		"next_count":      atomic.LoadInt64(&kvNextCount),
+		"next_latency_ns": atomic.LoadInt64(&kvNextLatencyNs),
+		"next_bytes":      atomic.LoadInt64(&kvNextBytes),
+	}
+}
+
+// GetKvStatsJSON returns the counters as a JSON byte slice.
+func GetKvStatsJSON() ([]byte, error) {
+	return json.Marshal(GetKvStats())
+}
+
+// ResetKvStats zeros all counters.
+func ResetKvStats() {
+	atomic.StoreInt64(&kvGetCount, 0)
+	atomic.StoreInt64(&kvGetFoundCount, 0)
+	atomic.StoreInt64(&kvGetLatencyNs, 0)
+	atomic.StoreInt64(&kvGetBytes, 0)
+	atomic.StoreInt64(&kvSetCount, 0)
+	atomic.StoreInt64(&kvSetLatencyNs, 0)
+	atomic.StoreInt64(&kvSetBytes, 0)
+	atomic.StoreInt64(&kvSeekCount, 0)
+	atomic.StoreInt64(&kvSeekLatencyNs, 0)
+	atomic.StoreInt64(&kvSeekBytes, 0)
+	atomic.StoreInt64(&kvNextCount, 0)
+	atomic.StoreInt64(&kvNextLatencyNs, 0)
+	atomic.StoreInt64(&kvNextBytes, 0)
+}
