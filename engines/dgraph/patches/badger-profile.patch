@@ -0,0 +1,197 @@
+//go:build histogram
+
+package y
+
+import (
+	"encoding/json"
+	"expvar"
+	"time"
+
+	hdrhistogram "github.com/HdrHistogram/hdrhistogram-go"
+)
+
+const (
+	BADGER_CUSTOM_METRIC_PREFIX = "badger_custom_"
+)
+
+var (
+	getLatencyHisto     *hdrhistogram.Histogram
+	getSizeHisto        *hdrhistogram.Histogram
+	setLatencyHisto     *hdrhistogram.Histogram
+	setSizeHisto        *hdrhistogram.Histogram
+	deleteLatencyHisto  *hdrhistogram.Histogram
+	commitLatencyHisto  *hdrhistogram.Histogram
+	itrSeekLatencyHisto *hdrhistogram.Histogram
+	itrSeekSizeHisto    *hdrhistogram.Histogram
+	itrNextLatencyHisto *hdrhistogram.Histogram
+	itrNextSizeHisto    *hdrhistogram.Histogram
+
+	itrLatencyTotal  *expvar.Int
+	scanLatencyTotal *expvar.Int
+	scanCount        *expvar.Int
+)
+
+func init() {
+	getLatencyHisto = hdrhistogram.New(1, 1000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"get_latency_histogram", &expvarHistogram{getLatencyHisto})
+	getSizeHisto = hdrhistogram.New(1, 8000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"get_size_histogram", &expvarHistogram{getSizeHisto})
+
+	setLatencyHisto = hdrhistogram.New(1, 1000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"set_latency_histogram", &expvarHistogram{setLatencyHisto})
+	setSizeHisto = hdrhistogram.New(1, 8000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"set_size_histogram", &expvarHistogram{setSizeHisto})
+
+	deleteLatencyHisto = hdrhistogram.New(1, 1000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"delete_latency_histogram", &expvarHistogram{deleteLatencyHisto})
+	commitLatencyHisto = hdrhistogram.New(1, 1000000, 3)
+
+	itrSeekLatencyHisto = hdrhistogram.New(1, 1000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"itr_seek_latency_histogram", &expvarHistogram{itrSeekLatencyHisto})
+	itrSeekSizeHisto = hdrhistogram.New(1, 8000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"itr_seek_size_histogram", &expvarHistogram{itrSeekSizeHisto})
+
+	itrNextLatencyHisto = hdrhistogram.New(1, 1000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"itr_next_latency_histogram", &expvarHistogram{itrNextLatencyHisto})
+	itrNextSizeHisto = hdrhistogram.New(1, 8000000, 3)
+	expvar.Publish(BADGER_CUSTOM_METRIC_PREFIX+"itr_next_size_histogram", &expvarHistogram{itrNextSizeHisto})
+
+	itrLatencyTotal = expvar.NewInt(BADGER_CUSTOM_METRIC_PREFIX + "itr_latency_us")
+	scanLatencyTotal = expvar.NewInt(BADGER_CUSTOM_METRIC_PREFIX + "scan_latency_us")
+	scanCount = expvar.NewInt(BADGER_CUSTOM_METRIC_PREFIX + "scan_count")
+}
+
+type HistogramExport struct {
+	P50   int64   `json:"p50"`
+	P95   int64   `json:"p95"`
+	P99   int64   `json:"p99"`
+	Max   int64   `json:"max"`
+	Min   int64   `json:"min"`
+	Mean  float64 `json:"mean"`
+	Count int64   `json:"count"`
+	Sum   int64   `json:"sum"`
+}
+
+type expvarHistogram struct {
+	h *hdrhistogram.Histogram
+}
+
+func (e *expvarHistogram) String() string {
+	he := HistogramExport{
+		P50:   e.h.ValueAtQuantile(50),
+		P95:   e.h.ValueAtQuantile(95),
+		P99:   e.h.ValueAtQuantile(99),
+		Max:   e.h.Max(),
+		Min:   e.h.Min(),
+		Mean:  e.h.Mean(),
+		Count: e.h.TotalCount(),
+		Sum:   int64(float64(e.h.TotalCount()) * e.h.Mean()),
+	}
+	b, _ := json.Marshal(he)
+	return string(b)
+}
+
+func RecordGetLatency(enabled bool, latency time.Duration) {
+	if !enabled {
+		return
+	}
+	getLatencyHisto.RecordValue(latency.Microseconds())
+}
+
+func RecordGetSize(enabled bool, size int) {
+	if !enabled {
+		return
+	}
+	getSizeHisto.RecordValue(int64(size))
+}
+
+func RecordPutLatency(enabled bool, latency time.Duration) {
+	if !enabled {
+		return
+	}
+	setLatencyHisto.RecordValue(latency.Microseconds())
+}
+
+func RecordPutSize(enabled bool, size int) {
+	if !enabled {
+		return
+	}
+	setSizeHisto.RecordValue(int64(size))
+}
+
+func RecordDeleteLatency(enabled bool, latency time.Duration) {
+	if !enabled {
+		return
+	}
+	deleteLatencyHisto.RecordValue(latency.Microseconds())
+}
+
+func RecordCommitLatency(enabled bool, latency time.Duration) {
+	if !enabled {
+		return
+	}
+	commitLatencyHisto.RecordValue(latency.Microseconds())
+}
+
+func RecordItrLatency(enabled bool, latency time.Duration) {
+	if !enabled {
+		return
+	}
+	itrLatencyTotal.Add(latency.Microseconds())
+}
+
+func RecordItrSeekLatency(enabled bool, latency time.Duration) {
+	if !enabled {
+		return
+	}
+	itrSeekLatencyHisto.RecordValue(latency.Microseconds())
+}
+
+func RecordItrSeekSize(enabled bool, size int) {
+	if !enabled {
+		return
+	}
+	itrSeekSizeHisto.RecordValue(int64(size))
+}
+
+func RecordItrNextLatency(enabled bool, latency time.Duration) {
+	if !enabled {
+		return
+	}
+	itrNextLatencyHisto.RecordValue(latency.Microseconds())
+}
+
+func RecordItrNextSize(enabled bool, size int) {
+	if !enabled {
+		return
+	}
+	itrNextSizeHisto.RecordValue(int64(size))
+}
+
+func RecordScanLatency(enabled bool, latency time.Duration) {
+	if !enabled {
+		return
+	}
+	scanLatencyTotal.Add(latency.Microseconds())
+	scanCount.Add(1)
+}
+
+func ResetHistograms() {
+	getLatencyHisto.Reset()
+	getSizeHisto.Reset()
+	setLatencyHisto.Reset()
+	setSizeHisto.Reset()
+	deleteLatencyHisto.Reset()
+	commitLatencyHisto.Reset()
+	itrSeekLatencyHisto.Reset()
+	itrSeekSizeHisto.Reset()
+	itrNextLatencyHisto.Reset()
+	itrNextSizeHisto.Reset()
+}
+
+func ResetMetrics() {
+	ResetHistograms()
+	itrLatencyTotal.Set(0)
+	scanCount.Set(0)
+	scanLatencyTotal.Set(0)
+}
