+// ── KV operation tracing ────────────────────────────────────────────
+// Per-op stack trace logging for debugging KV access patterns.
+// Toggle at runtime: PUT /kvtrace/seek/enable, /kvtrace/get/enable, etc.
+
+func kvtraceLevelName(level int) string {
+	switch level {
+	case badger.TraceKeys:
+		return "keys"
+	case badger.TraceStack:
+		return "stack"
+	default:
+		return "off"
+	}
+}
+
+func kvtraceHandler(w http.ResponseWriter, r *http.Request) {
+	res := map[string]interface{}{
+		"seek": kvtraceLevelName(badger.TraceSeek),
+		"next": kvtraceLevelName(badger.TraceNext),
+		"get":  kvtraceLevelName(badger.TraceGet),
+	}
+	js, _ := json.Marshal(res)
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	w.Write(js)
+}
+
+func kvtraceToggleHandler(w http.ResponseWriter, r *http.Request) {
+	// Path: /kvtrace/{op}/{level}
+	//   op:    seek, next, get, all
+	//   level: disable (off), keys (key only), stack (key + stack trace)
+	parts := strings.Split(strings.TrimPrefix(r.URL.Path, "/kvtrace/"), "/")
+	if len(parts) != 2 {
+		x.SetStatus(w, x.ErrorInvalidRequest,
+			"Usage: /kvtrace/{seek|next|get|all}/{disable|keys|stack}")
+		return
+	}
+	op, levelStr := parts[0], parts[1]
+
+	var level int
+	switch levelStr {
+	case "disable", "off":
+		level = badger.TraceOff
+	case "keys":
+		level = badger.TraceKeys
+	case "stack":
+		level = badger.TraceStack
+	// backward compat: enable = stack
+	case "enable":
+		level = badger.TraceStack
+	default:
+		x.SetStatus(w, x.ErrorInvalidRequest,
+			"Unknown level: "+levelStr+". Use disable, keys, or stack")
+		return
+	}
+
+	switch op {
+	case "seek":
+		badger.TraceSeek = level
+	case "next":
+		badger.TraceNext = level
+	case "get":
+		badger.TraceGet = level
+	case "all":
+		badger.TraceSeek = level
+		badger.TraceNext = level
+		badger.TraceGet = level
+	default:
+		x.SetStatus(w, x.ErrorInvalidRequest,
+			"Unknown op: "+op+". Use seek, next, get, or all")
+		return
+	}
+
+	res := map[string]interface{}{
+		"data": map[string]interface{}{
+			"code":    "Success",
+			"message": fmt.Sprintf("Trace %s → %s", op, kvtraceLevelName(level)),
+		},
+	}
+	js, _ := json.Marshal(res)
+	w.WriteHeader(http.StatusOK)
+	w.Write(js)
+}
