+// Force-path knobs for filter access-path selection. Mirror the /detsort
+// handlers above. Each knob (/eqfilterpath, /ineqfilterpath) has a status GET
+// and a setter (POST .../{default|index|per_vertex}). See worker/task.go
+// EqFilterPath / IneqFilterPath for what each mode pins.
+
+func parseFilterPathMode(s string) (worker.FilterPathMode, bool) {
+	switch s {
+	case "default":
+		return worker.FilterPathDefault, true
+	case "index":
+		return worker.FilterPathIndex, true
+	case "per_vertex":
+		return worker.FilterPathPerVertex, true
+	}
+	return worker.FilterPathDefault, false
+}
+
+func filterPathModeLabel(m worker.FilterPathMode) string {
+	switch m {
+	case worker.FilterPathIndex:
+		return "index"
+	case worker.FilterPathPerVertex:
+		return "per_vertex"
+	default:
+		return "default"
+	}
+}
+
+func filterPathStatus(target *atomic.Int32, knob string, w http.ResponseWriter) {
+	res := map[string]interface{}{
+		"knob": knob,
+		"mode": filterPathModeLabel(worker.FilterPathMode(target.Load())),
+	}
+	js, _ := json.Marshal(res)
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	w.Write(js)
+}
+
+func filterPathSet(target *atomic.Int32, knob string, w http.ResponseWriter, r *http.Request) {
+	seg := path.Base(r.URL.Path)
+	mode, ok := parseFilterPathMode(seg)
+	if !ok {
+		res := map[string]interface{}{
+			"errors": []map[string]interface{}{{
+				"code":    "Error",
+				"message": fmt.Sprintf("unknown %s mode %q; want default|index|per_vertex", knob, seg),
+			}},
+		}
+		js, _ := json.Marshal(res)
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusBadRequest)
+		w.Write(js)
+		return
+	}
+	target.Store(int32(mode))
+	res := map[string]interface{}{
+		"data": map[string]interface{}{
+			"code":    "Success",
+			"message": fmt.Sprintf("%s set to %q (pins the filter access path for cost-model measurement)", knob, filterPathModeLabel(mode)),
+		},
+	}
+	js, _ := json.Marshal(res)
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	w.Write(js)
+}
