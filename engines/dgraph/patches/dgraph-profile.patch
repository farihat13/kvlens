index 000000000..a00ee5dfe
--- /dev/null
+++ dgraph/dgraph-25.0.0/posting/badger_busy_time.go
@@ -0,0 +1,126 @@
+//go:build badgerbusy
+
+package posting
+
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/dgraph-io/badger/v4"
+	"github.com/golang/glog"
+)
+
+// BadgerBusyTime measures wall time during which at least one tracked operation is in-flight.
+// How it works in detail:
+//   - Callers call Begin() when starting an operation, and End() when ending it.
+//   - If the active count goes from 0 to 1, we record the start time.
+//     If the active count is already >1, we do nothing.
+//   - If the active count goes from 1 to 0, we add the elapsed time since start to totalNS.
+//     If the active count is already >1, we do nothing.
+//   - WallDuration() returns the total accumulated time.
+type BadgerBusyTime struct {
+	active  atomic.Int64
+	startNS atomic.Int64
+	totalNS atomic.Int64
+}
+
+func (b *BadgerBusyTime) Begin() {
+	if b == nil {
+		return
+	}
+	if b.active.Add(1) == 1 {
+		b.startNS.Store(time.Now().UnixNano())
+	}
+}
+
+func (b *BadgerBusyTime) End() {
+	if b == nil {
+		return
+	}
+	n := b.active.Add(-1)
+	if n < 0 {
+		// Underflow indicates a bug in caller instrumentation; clamp to keep accounting sane.
+		b.active.Store(0)
+		return
+	}
+	if n == 0 {
+		start := b.startNS.Load()
+		if start != 0 {
+			b.totalNS.Add(time.Now().UnixNano() - start)
+		}
+	}
+}
+
+func (b *BadgerBusyTime) WallDuration() time.Duration {
+	if b == nil {
+		return 0
+	}
+	return time.Duration(b.totalNS.Load())
+}
+
+type badgerBusyEntry struct {
+	bt   *BadgerBusyTime
+	refs atomic.Int64
+}
+
+var badgerBusyByReadTs sync.Map // map[uint64]*badgerBusyEntry
+
+// RegisterBadgerBusyTime installs a tracker for this readTs and returns a cleanup func.
+// Safe for nested registration: only removed after the last cleanup.
+
+func RegisterBadgerBusyTime(readTs uint64) (*BadgerBusyTime, func()) {
+	if glog.V(3) {
+		glog.Infof("RegisterBadgerBusyTime called for readTs: %d", readTs)
+	}
+	e := &badgerBusyEntry{bt: &BadgerBusyTime{}}
+	actual, _ := badgerBusyByReadTs.LoadOrStore(readTs, e)
+	e = actual.(*badgerBusyEntry)
+	e.refs.Add(1)
+
+	cleanup := func() {
+		if e.refs.Add(-1) == 0 {
+			val, ok := badgerBusyByReadTs.Load(readTs)
+			if ok && val == e {
+				badgerBusyByReadTs.Delete(readTs)
+				if glog.V(3) {
+					glog.Infof("Unregistered BadgerBusyTime for readTs: %d. Total wall(ms)=%d",
+						readTs, e.bt.WallDuration().Milliseconds())
+				}
+			}
+		}
+	}
+	return e.bt, cleanup
+}
+
+func badgerBusyForReadTs(readTs uint64) *BadgerBusyTime {
+	val, ok := badgerBusyByReadTs.Load(readTs)
+	if !ok {
+		return nil
+	}
+	return val.(*badgerBusyEntry).bt
+}
+
+// BeginBadgerBusyForReadTs begins busy-time tracking for readTs and returns an End func.
+// Safe to call even if no tracker is registered (it returns a no-op End).
+func BeginBadgerBusyForReadTs(readTs uint64) func() {
+	bt := badgerBusyForReadTs(readTs)
+	if bt == nil {
+		return func() {}
+	}
+	bt.Begin()
+	return func() { bt.End() }
+}
+
+// BeginBadgerBusyFromTxn begins busy-time tracking using txn.ReadTs() and returns an End func.
+// Safe to call even if txn is nil or no tracker is registered.
+func BeginBadgerBusyFromTxn(txn *badger.Txn) func() {
+	if txn == nil {
+		return func() {}
+	}
+	return BeginBadgerBusyForReadTs(txn.ReadTs())
+}
+
+func BadgerBusyForReadTs(readTs uint64) *BadgerBusyTime {
+	return badgerBusyForReadTs(readTs)
+}
