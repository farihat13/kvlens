+// TR/DG: EXPERIMENTAL precise write-cost measurement. Roll up ONLY the keys dirtied
+// by mutations committed since the last drain (recording must be enabled first). Fast
+// (no full scan) but INCOMPLETE — undercounts index maintenance (see DrainRecorded);
+// the write microbenchmarks use /rollup/forceall instead.
+func drainRollupHandler(w http.ResponseWriter, r *http.Request) {
+	glog.V(1).Info("T/DG: Got drain rollup request via HTTP")
+	defer glog.Info("T/DG: Drain rollup request done via HTTP")
+	n, err := posting.IncrRollup.DrainRecorded()
+	if err != nil {
+		glog.Errorf("T/DG: drainRollup failed: %v", err)
+		x.SetStatus(w, x.Error, fmt.Sprintf("Drain rollup failed: %v", err))
+		return
+	}
+	res := map[string]interface{}{
+		"data": map[string]interface{}{
+			"code":    "Success",
+			"message": "Drain rollup done",
+			"keys":    n,
+		},
+	}
+	js, _ := json.Marshal(res)
+	w.WriteHeader(http.StatusOK)
+	w.Write(js)
+}
