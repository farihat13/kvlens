+// explainNode serializes one SubGraph node into a plain map for the EXPLAIN JSON. It mirrors
+// the DebugPrint walk (Filters then Children) but emits structured data the Python cost model
+// (cost_eval/dgraph_plan) can parse, instead of scraping the DebugPrint text from alpha.log.
+//
+// The static plan (built pre-execution) carries the access structure the cost rules need: the
+// root index func (SrcFunc), the `~`-prefixed reverse attr, the selected scalar predicates
+// (children), the @filter subtree, order/first/offset, and @count. SrcUIDs/DestUIDs are only
+// populated after execution, so the per-node sizes (srcSz/destSz) are included only in profile
+// mode.
+func (sg *SubGraph) explainNode(profile bool) map[string]interface{} {
+	node := map[string]interface{}{
+		"attr":     sg.Attr,
+		"alias":    sg.Params.Alias,
+		"reverse":  strings.HasPrefix(sg.Attr, "~"),
+		"docount":  sg.Params.DoCount,
+		"first":    sg.Params.Count,
+		"offset":   sg.Params.Offset,
+		"expand":   sg.Params.Expand,
+		"filterOp": sg.FilterOp,
+	}
+	if sg.SrcFunc != nil {
+		args := make([]string, len(sg.SrcFunc.Args))
+		for i, a := range sg.SrcFunc.Args {
+			args[i] = a.Value
+		}
+		node["func"] = map[string]interface{}{
+			"name":  sg.SrcFunc.Name,
+			"args":  args,
+			"count": sg.SrcFunc.IsCount,
+		}
+	}
+	if len(sg.Params.Order) > 0 {
+		order := make([]map[string]interface{}, len(sg.Params.Order))
+		for i, o := range sg.Params.Order {
+			order[i] = map[string]interface{}{"attr": o.Attr, "desc": o.Desc}
+		}
+		node["order"] = order
+	}
+	if len(sg.Params.Langs) > 0 {
+		node["langs"] = sg.Params.Langs
+	}
+	if len(sg.Filters) > 0 {
+		filters := make([]map[string]interface{}, len(sg.Filters))
+		for i, f := range sg.Filters {
+			filters[i] = f.explainNode(profile)
+		}
+		node["filters"] = filters
+	}
+	if len(sg.Children) > 0 {
+		children := make([]map[string]interface{}, len(sg.Children))
+		for i, c := range sg.Children {
+			children[i] = c.explainNode(profile)
+		}
+		node["children"] = children
+	}
+	if profile {
+		var src, dst int
+		if sg.SrcUIDs != nil {
+			src = len(sg.SrcUIDs.Uids)
+		}
+		if sg.DestUIDs != nil {
+			dst = len(sg.DestUIDs.Uids)
+		}
+		node["srcSz"] = src
+		node["destSz"] = dst
+		node["count_vals"] = len(sg.counts)
+		node["value_vals"] = len(sg.valueMatrix)
+	}
+	return node
+}
+
+// buildExplainJSON serializes the whole request plan (one entry per top-level query block) to
+// JSON. See explainNode for the per-node shape.
+func (req *Request) buildExplainJSON(profile bool) []byte {
+	subgraphs := make([]map[string]interface{}, len(req.Subgraphs))
+	for i, sg := range req.Subgraphs {
+		subgraphs[i] = sg.explainNode(profile)
+	}
+	out, err := json.Marshal(map[string]interface{}{"subgraphs": subgraphs})
+	if err != nil {
+		// Marshaling a tree of plain maps should never fail; surface it inside the JSON so the
+		// caller still gets a parseable (if degenerate) response rather than a silent empty body.
+		return []byte(fmt.Sprintf("{%q:%q}", "error", err.Error()))
+	}
+	return out
+}
