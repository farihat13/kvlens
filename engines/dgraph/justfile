# Run all IC queries with hooks (metrics collection)
ldbc-ic-collect:
    python3 -u ../../python/kvengines/dgraph/ldbc/run_ldbc.py --all --nparam 35 --hooks --save-results

warmup:
    just ldbc-ic > warmup.log 2>&1

# Profile the LDBC interactive queries with detailed tracing enabled
ldbc-icq-seqrun:
    rm -f badger/y/functrace.go || true
    rm -f badger/y/nofunctrace.go || true
    rm -f dgraph-25.0.0/posting/badger_busy_time.go || true
    bash scripts/apply-patch.sh badger -f badger.patch
    bash scripts/apply-patch.sh dgraph -f dgraph.profile.patch
    just build
    sleep 1
    just kill
    sleep 2
    just zero
    just alpha-now
    sleep 10
    echo "warmup..."
    just ldbc-ic > ic.log 2>&1
    echo "profile run..."
    python3 -u ../../python/kvengines/dgraph/ldbc/run_ldbc.py --all --nparam 35 --hooks --save-results 2>&1 | tee profile.log

# =============================
# Metrics
# =============================

# Snapshot metrics before an experiment
before:
    curl -s localhost:8080/metrics > 0metrics.log
    curl -s localhost:8080/debug/vars | jq > 0debug_vars.log
    curl -s localhost:8080/kvstats | jq > 0kvstats.log

# Snapshot metrics after an experiment
after:
    curl -s localhost:8080/metrics > 1metrics.log
    curl -s localhost:8080/debug/vars | jq > 1debug_vars.log
    curl -s localhost:8080/kvstats | jq > 1kvstats.log

metrics:
    curl -s localhost:8080/metrics | tee metrics.txt

vars:
    curl -s localhost:8080/debug/vars | jq | tee debug_vars.txt

pprof-heap:
    curl -s localhost:8080/debug/pprof/heap > heap.prof
    go tool pprof -http=:8081 heap.prof

pprof-cpu seconds="30":
    curl -s "localhost:8080/debug/pprof/profile?seconds={{seconds}}" > cpu.prof
    go tool pprof -http=:8081 cpu.prof

jemalloc:
    curl -s localhost:8080/debug/jemalloc

# =============================
# DB-specific (Dgraph)
# =============================

shutdown:
    curl -X GET localhost:8080/admin/shutdown | jq

# Get/set cache memory limit
cache-size:
    curl -X GET localhost:8080/admin/config/cache_mb | jq

cache-set mb="2048":
    curl -X PUT localhost:8080/admin/config/cache_mb -d '{{mb}}' | jq

# Zero state
state-zero:
    curl -s localhost:6080/state | jq
# Alpha state
state-alpha:
    curl -s localhost:8080/state | jq

setschema path="data/ldbcTypes.schema":
    curl -X POST localhost:8080/alter -H "Content-Type: application/dql" --data-binary @{{path}} | jq

getschema:
    curl -s -X POST localhost:8080/query -H "Content-Type: application/graphql+-" -d 'schema {}' | jq

# Assume alpha and zero are running
rollup:
    curl -X POST localhost:8080/rollup/pause
    sleep 1
    curl -X POST localhost:8080/rollup/forceall

pause-rollup:
    curl -X POST localhost:8080/rollup/pause | jq
resume-rollup:
    curl -X POST localhost:8080/rollup/resume | jq
force-rollup:
    curl -X POST localhost:8080/rollup/forceall | jq

gettrace:
    curl -X POST localhost:8080/trace/counts | jq | tee trace_count.log

resettrace:
    curl -X POST localhost:8080/trace/reset

jaeger:
    -bash -c "docker rm -f jaeger"
    docker run -d --name jaeger \
        -e COLLECTOR_OTLP_ENABLED=true \
        -p 16686:16686 \
        -p 14268:14268 \
        -p 4317:4317 \
        -p 4318:4318 \
        jaegertracing/all-in-one:1.56

# Start Dgraph Alpha node with Jaeger tracing
jalpha:
    #!/bin/bash
    mkdir -p ${DGRAPH_RUNSDIR} && cd ${DGRAPH_RUNSDIR}
    tmux new-session -d -s alpha 'dgraph alpha --trace "jaeger=localhost:4318;ratio=1" --security whitelist=0.0.0.0/0 2>&1 | tee alpha.log'
    # Open http://localhost:16686/


