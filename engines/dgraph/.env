# ============================================================
# DGRAPH WIRING CONFIGURATION (Immutable)
# ============================================================
# This file contains Dgraph-specific paths and toolchain config.
# Paths are computed relative to this file, so they hold in any checkout.
#
# DO NOT put experiment knobs here (cache size, device names, IPs, etc.)
# The measured settings are in engines/env.sh.
# ============================================================

# Compute paths relative to this file's location
export MY_DGRAPH_ROOTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source directories (relative to ROOTDIR)
export DGRAPH_SRCDIR="${MY_DGRAPH_ROOTDIR}/dgraph-25.0.0"
export BADGER_SRCDIR="${MY_DGRAPH_ROOTDIR}/badger"

# Runtime directories
export DGRAPH_RUNSDIR="${MY_DGRAPH_ROOTDIR}/runs"
export DGRAPH_LOGDIR="${MY_DGRAPH_ROOTDIR}/runs/logs"
export DGRAPH_BINARYDIR="${MY_DGRAPH_ROOTDIR}/bin"

# Data and query directories
export DGRAPH_DATADIR="${MY_DGRAPH_ROOTDIR}/data"
export DGRAPH_QUERYDIR="${MY_DGRAPH_ROOTDIR}/../queries/ldbc/dgraph"

# Analysis and scripts
export DGRAPH_SCRIPTSDIR="${MY_DGRAPH_ROOTDIR}/scripts"
