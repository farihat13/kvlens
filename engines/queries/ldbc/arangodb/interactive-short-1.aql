// IS1: Profile of a Person
// Given a personId, return their profile info and city
FOR p IN Person
    FILTER p._key == TO_STRING(@personId)
    FOR city IN 1..1 OUTBOUND p isLocatedIn
        RETURN {
            firstName: p.firstName,
            lastName: p.lastName,
            birthday: p.birthday,
            locationIP: p.locationIP,
            browserUsed: p.browserUsed,
            cityId: TO_NUMBER(city._key),
            gender: p.gender,
            creationDate: p.creationDate
        }
