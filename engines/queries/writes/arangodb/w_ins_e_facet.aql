// w_ins_e_facet -- insert a knows edge carrying its creationDate, between two persons that are not adjacent.
// Writes: as w_ins_e_plain, with a real knows.creationDate index entry instead of a null one.
// Evaluator: workloads/writes/microbench/queries.py w_ins_e_facet -- insert_edge(knows, ..., {creationDate}).
// mb2 lineage: MB86 (same statement; its keys were inlined).
// Anchor: the two Person _keys, bound variables, as w_upd_plain.
INSERT { _from: CONCAT("Person/", @src), _to: CONCAT("Person/", @dst), creationDate: 1577836800000 } INTO knows
