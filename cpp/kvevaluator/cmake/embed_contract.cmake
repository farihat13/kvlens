# Writes contract_data.cc: the shared data files (inputs/contract/*.json) as raw string literals, so the binary carries
# the facts of the commit it was built from (src/contract/contract.h reads them). Run by the build when a file changes.
# -DOUT=<file> -DCONTRACT_DIR=<dir> -DNAMES=<a|b|c> (file stems; the variable is kContract_<stem>)
string(REPLACE "|" ";" NAMES "${NAMES}")
set(_text "// generated by cmake/embed_contract.cmake from ${CONTRACT_DIR}: do not edit\nnamespace evalcpp::contract {\n")
foreach(_name ${NAMES})
  file(READ "${CONTRACT_DIR}/${_name}.json" _json)
  string(FIND "${_json}" ")kvcontract\"" _clash)
  if(NOT _clash EQUAL -1)
    message(FATAL_ERROR "${CONTRACT_DIR}/${_name}.json holds the raw-string delimiter )kvcontract\"")
  endif()
  string(APPEND _text "extern const char* const kContract_${_name};\nconst char* const kContract_${_name} = R\"kvcontract(${_json})kvcontract\";\n")
endforeach()
string(APPEND _text "}  // namespace evalcpp::contract\n")
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)   # unchanged: keep the file, so nothing recompiles
  file(WRITE "${OUT}" "${_text}")
endif()
