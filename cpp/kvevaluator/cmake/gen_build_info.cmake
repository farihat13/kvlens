# Writes build_info.cc with the git SHA + dirty flag of this tree, the librocksdb.a sha256 and its pinned source,
# and the compiler. Run at every build (cheap), so a stale SHA
# can never be baked into a binary.
# Only a git tree that CONTAINS this dir names a commit. A release archive with no .git (git archive, a GitHub or Zenodo
# zip) names the commit git wrote into RELEASE_FILE (export-subst, .gitattributes) and the dirty flag "release": its
# files are the commit's as archived, not checked against it. Any other copy with no .git (a tarball, a scratch copy)
# says "unknown" for both, never dirty=false.
set(GIT_SHA "unknown")
set(DIRTY "\"unknown\"")
if(NOT BUILD_COMMIT STREQUAL "")
  # a cache build (run/build_cpp.py): the source is a git archive with no .git, so the driver names the commit, the
  # dirty flag of the tree it archived, and the cache key
  set(GIT_SHA "${BUILD_COMMIT}")
  set(DIRTY "\"${BUILD_DIRTY}\"")
else()
execute_process(COMMAND git rev-parse --show-toplevel WORKING_DIRECTORY ${SRC_DIR}
                OUTPUT_VARIABLE GIT_TOP OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE GIT_RC)
set(RELEASE_SHA "")
if(NOT RELEASE_FILE STREQUAL "" AND EXISTS "${RELEASE_FILE}")
  file(STRINGS "${RELEASE_FILE}" RELEASE_LINES REGEX "^[0-9a-f]+$")   # in a git checkout the line is still $Format:%H$
  list(LENGTH RELEASE_LINES N_RELEASE)
  string(LENGTH "${RELEASE_LINES}" RELEASE_LEN)
  if(N_RELEASE EQUAL 1 AND RELEASE_LEN EQUAL 40)   # a full sha, as Python reads it (paths.release_commit)
    set(RELEASE_SHA "${RELEASE_LINES}")
  endif()
endif()
if((NOT GIT_RC EQUAL 0 OR GIT_TOP STREQUAL "") AND NOT RELEASE_SHA STREQUAL "")
  set(GIT_SHA "${RELEASE_SHA}")
  set(DIRTY "\"release\"")
elseif(GIT_RC EQUAL 0 AND NOT GIT_TOP STREQUAL "")
  execute_process(COMMAND git rev-parse --verify -q HEAD WORKING_DIRECTORY ${SRC_DIR}
                  OUTPUT_VARIABLE GIT_SHA OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE HEAD_RC)
  if(NOT HEAD_RC EQUAL 0 OR NOT GIT_SHA MATCHES "^[0-9a-f]+$")   # a repo with no commit yet names none
    set(GIT_SHA "unknown")
  endif()
  string(REPLACE "|" ";" STATUS_PATHS "${STATUS_PATHS}")   # the repo paths block's paths, absolute
  execute_process(COMMAND git status --porcelain -- . ${STATUS_PATHS} WORKING_DIRECTORY ${SRC_DIR}
                  OUTPUT_VARIABLE GIT_STATUS OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(GIT_STATUS STREQUAL "")
    set(DIRTY "\"false\"")
  else()
    set(DIRTY "\"true\"")
  endif()
endif()
endif()
file(SHA256 "${ROCKSDB_A}" ROCKSDB_A_SHA256)   # at build time: the library is built after configure
set(ALLOCATOR_LIB_SHA256 "")
if(NOT ALLOCATOR_LIB STREQUAL "")
  file(SHA256 "${ALLOCATOR_LIB}" ALLOCATOR_LIB_SHA256)   # at build time: an upgraded library changes the stamp
endif()
set(CONTENT "// generated by cmake/gen_build_info.cmake -- do not edit
#include \"provenance.h\"
namespace evalcpp {
const char* kBuildGitSha = \"${GIT_SHA}\";
const char* kBuildKey = \"${BUILD_KEY}\";
const char* kBuildGitDirty = ${DIRTY};   // \"true\" | \"false\" | \"release\" | \"unknown\"
const char* kRocksdbASha256 = \"${ROCKSDB_A_SHA256}\";
const char* kRocksdbSource = \"${ROCKSDB_SOURCE}\";
const char* kCompiler = \"${COMPILER_ID} ${COMPILER_VERSION}\";
const char* kCxxFlags = \"${CXX_FLAGS}\";
const char* kAllocator = \"${ALLOCATOR}\";
const char* kAllocatorVersion = \"${ALLOCATOR_VERSION}\";
const char* kAllocatorLibSha256 = \"${ALLOCATOR_LIB_SHA256}\";
}
")
# only rewrite when changed, so an unchanged tree does not relink
if(EXISTS ${OUT})
  file(READ ${OUT} OLD)
else()
  set(OLD "")
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE ${OUT} "${CONTENT}")
endif()
